---
import { getCollection } from "astro:content";

interface Props {
  code: string;
  label?: string;
  title?: string;
  credits?: string;
  description?: string;
}

const { code, label, title, credits, description } = Astro.props;

const normalizedCode = code.trim();

let resolvedTitle = title ?? "";
let resolvedCredits = credits ?? "";
let resolvedDescription = description ?? "";

if (!resolvedTitle || !resolvedDescription) {
  const pathnameParts = Astro.url.pathname.split("/").filter(Boolean);
  const year = pathnameParts[0] ?? "";

  const courses = await getCollection("courses");
  const yearCourses = courses.filter((entry) =>
    entry.id.startsWith(`${year}/courses/`),
  );

  const codeKey = normalizedCode.toLowerCase().replace(/\s+/g, "-");
  const fallbackKey = normalizedCode.toLowerCase();
  const resolved =
    yearCourses.find(
      (entry) => entry.data.code.toLowerCase() === fallbackKey,
    ) ||
    yearCourses.find((entry) => entry.data.code.toLowerCase() === codeKey) ||
    yearCourses.find(
      (entry) => (entry.id.split("/").pop() ?? "").toLowerCase() === codeKey,
    );

  if (resolved) {
    resolvedTitle = resolvedTitle || resolved.data.title;
    resolvedCredits = resolvedCredits || (resolved.data.credits ?? "");
    if (!resolvedDescription) {
      resolvedDescription =
        (resolved.body || "")
          .replace(/\[(.*?)\]\((.*?)\)/g, "$1")
          .replace(/[*_`~>#]/g, "")
          .trim() || "No description available.";
    }
  }
}

const displayLabel = label || normalizedCode;
const hasDetails = Boolean(
  resolvedTitle || resolvedCredits || resolvedDescription,
);
---

<span
  class="relative inline-flex items-center align-middle"
  data-tooltip-container
  data-tooltip-id={`course-tip-inline-${normalizedCode.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`}
>
  {
    hasDetails ? (
      <>
        <button
          type="button"
          class="inline-flex items-center border-0 bg-transparent p-0 m-0 text-left text-inherit cursor-pointer underline decoration-dotted underline-offset-2 rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-vhcc-blue"
          data-tooltip-trigger
          aria-label={`View details: ${displayLabel}`}
          aria-controls={`course-tip-inline-${normalizedCode.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`}
          aria-expanded="false"
          aria-haspopup="dialog"
        >
          {displayLabel}
        </button>
        <div
          id={`course-tip-inline-${normalizedCode.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`}
          role="dialog"
          aria-label={`Course details for ${normalizedCode}`}
          data-tooltip-panel
          data-tooltip-for={`course-tip-inline-${normalizedCode.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`}
          tabindex="-1"
          class="pointer-events-none invisible fixed -left-[9999px] -top-[9999px] z-50 max-h-[50vh] overflow-y-auto rounded-lg bg-white p-4 text-sm text-slate-700 opacity-0 shadow-xl ring-1 ring-black/5 transition-opacity dark:bg-gray-800 dark:text-gray-200 dark:ring-white/10"
        >
          <div class="flex items-start justify-between gap-2">
            <p class="font-semibold text-vhcc-navy wrap-break-word dark:text-sky-300">
              {normalizedCode}
              {resolvedTitle ? `: ${resolvedTitle}` : ""}
            </p>
            <button
              type="button"
              class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded border border-slate-300 text-slate-600 hover:border-vhcc-blue hover:text-vhcc-blue focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-vhcc-blue dark:border-gray-600 dark:text-gray-300 dark:hover:border-sky-400 dark:hover:text-sky-400"
              data-tooltip-close
              aria-label="Close course details"
            >
              ×
            </button>
          </div>
          {resolvedCredits && (
            <p class="mt-1 text-slate-700 wrap-break-word dark:text-gray-300">
              <span class="font-semibold">Credits:</span> {resolvedCredits}
            </p>
          )}
          {resolvedDescription && (
            <p class="mt-1 leading-relaxed wrap-break-word">
              {resolvedDescription}
            </p>
          )}
        </div>
      </>
    ) : (
      <span>{displayLabel}</span>
    )
  }
</span>

<script is:inline>
  (() => {
    if (window.__vhccTooltipInit) return;
    window.__vhccTooltipInit = true;

    const backdrop = document.getElementById("tooltip-backdrop");

    // Track the single currently-open panel and its container
    let activePanel = null;
    let activeContainer = null;

    const showBackdrop = () => {
      if (!backdrop) return;
      backdrop.style.opacity = "1";
      backdrop.style.pointerEvents = "auto";
    };
    const hideBackdrop = () => {
      if (!backdrop) return;
      backdrop.style.opacity = "0";
      backdrop.style.pointerEvents = "none";
    };

    const closeActive = () => {
      if (!activePanel || !activeContainer) return;
      const panel = activePanel;
      const container = activeContainer;
      activePanel = null;
      activeContainer = null;

      panel.classList.add("invisible", "opacity-0", "pointer-events-none");
      panel.classList.remove("visible", "opacity-100", "pointer-events-auto");
      panel.removeAttribute("aria-modal");

      const returnTarget = panel._triggerEl;
      panel._triggerEl = null;

      if (panel._portalParent) {
        panel._portalParent.insertBefore(panel, panel._portalNext || null);
        panel.style.cssText = "position:fixed;left:-9999px;top:-9999px";
        panel._portalParent = null;
        panel._portalNext = null;
      }

      container.setAttribute("data-tooltip-open", "false");
      container.querySelectorAll("[data-tooltip-trigger]").forEach((t) => {
        t.setAttribute("aria-expanded", "false");
      });

      hideBackdrop();
      if (returnTarget) returnTarget.focus();
    };

    const openTooltip = (container, triggerEl) => {
      const tooltipId = container.dataset.tooltipId;
      const panel =
        container.querySelector("[data-tooltip-panel]") ||
        (tooltipId
          ? document.querySelector(`[data-tooltip-for="${tooltipId}"]`)
          : null);
      if (!panel) return;

      // Close any previously open tooltip first
      if (activePanel && activePanel !== panel) closeActive();

      const iBtn = container.querySelector("button[data-tooltip-trigger]");
      const rect = (iBtn || triggerEl || container).getBoundingClientRect();

      panel._portalParent = panel.parentElement;
      panel._portalNext = panel.nextSibling;
      panel._triggerEl = iBtn || triggerEl || null;
      document.body.appendChild(panel);

      if (window.innerWidth < 640) {
        panel.style.cssText =
          "position:fixed;left:12px;right:12px;bottom:12px;top:auto;width:auto;max-width:none;z-index:50";
      } else {
        const w = 320;
        let left = rect.left;
        if (left + w > window.innerWidth - 16)
          left = window.innerWidth - w - 16;
        panel.style.cssText = `position:fixed;top:${rect.bottom + 6}px;left:${left}px;width:${w}px;bottom:auto;right:auto;z-index:50`;
      }

      panel.classList.remove("invisible", "opacity-0", "pointer-events-none");
      panel.classList.add("visible", "opacity-100", "pointer-events-auto");
      panel.setAttribute("aria-modal", "true");

      activePanel = panel;
      activeContainer = container;

      container.setAttribute("data-tooltip-open", "true");
      container.querySelectorAll("[data-tooltip-trigger]").forEach((t) => {
        t.setAttribute("aria-expanded", "true");
      });

      showBackdrop();
      const closeBtn = panel.querySelector("[data-tooltip-close]");
      if (closeBtn) closeBtn.focus();
    };

    // Backdrop click always closes
    if (backdrop) backdrop.addEventListener("click", () => closeActive());

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      // Close button (× inside panel)
      if (target.closest("[data-tooltip-close]")) {
        closeActive();
        event.preventDefault();
        return;
      }

      // Trigger button (toggle open/close)
      const trigger = target.closest("[data-tooltip-trigger]");
      if (trigger && !target.closest("a")) {
        const container = trigger.closest("[data-tooltip-container]");
        if (!container) return;
        if (activeContainer === container) {
          closeActive();
        } else {
          openTooltip(container, trigger);
        }
        event.preventDefault();
        return;
      }

      // Click outside: close if not inside the active panel
      if (activePanel && !activePanel.contains(target)) {
        closeActive();
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeActive();

      // Keep Tab inside the open panel — otherwise keyboard users can
      // tab past it into the dimmed page behind it.
      if (event.key === "Tab" && activePanel) {
        const focusable = activePanel.querySelectorAll(
          'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
        );
        if (focusable.length === 0) return;
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
    });
  })();
</script>
