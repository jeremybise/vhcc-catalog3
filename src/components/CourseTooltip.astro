---
import { getCollection } from "astro:content";

interface Props {
  code: string;
  label?: string;
  title?: string;
  credits?: string;
  description?: string;
}

const { code, label, title, credits, description } = Astro.props;

const normalizedCode = code.trim();

let resolvedTitle = title ?? "";
let resolvedCredits = credits ?? "";
let resolvedDescription = description ?? "";

if (!resolvedTitle || !resolvedDescription) {
  const pathnameParts = Astro.url.pathname.split("/").filter(Boolean);
  const year = pathnameParts[0] ?? "";

  const courses = await getCollection("courses");
  const yearCourses = courses.filter((entry) =>
    entry.id.startsWith(`${year}/courses/`),
  );

  const codeKey = normalizedCode.toLowerCase().replace(/\s+/g, "-");
  const fallbackKey = normalizedCode.toLowerCase();
  const resolved =
    yearCourses.find(
      (entry) => entry.data.code.toLowerCase() === fallbackKey,
    ) ||
    yearCourses.find((entry) => entry.data.code.toLowerCase() === codeKey) ||
    yearCourses.find(
      (entry) => (entry.id.split("/").pop() ?? "").toLowerCase() === codeKey,
    );

  if (resolved) {
    resolvedTitle = resolvedTitle || resolved.data.title;
    resolvedCredits = resolvedCredits || (resolved.data.credits ?? "");
    if (!resolvedDescription) {
      resolvedDescription =
        (resolved.body || "")
          .replace(/\[(.*?)\]\((.*?)\)/g, "$1")
          .replace(/[*_`~>#]/g, "")
          .trim() || "No description available.";
    }
  }
}

const displayLabel = label || normalizedCode;
const hasDetails = Boolean(
  resolvedTitle || resolvedCredits || resolvedDescription,
);
---

<span
  class="group/tooltip relative inline-flex items-center gap-1 align-middle"
  data-tooltip-container
  data-tooltip-id={`course-tip-inline-${normalizedCode.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`}
>
  <span
    class="cursor-pointer underline decoration-dotted underline-offset-2"
    data-tooltip-trigger>{displayLabel}</span
  >
  {
    hasDetails && (
      <>
        <button
          type="button"
          class="inline-flex h-4 w-4 items-center justify-center rounded-full border border-slate-300 bg-white text-[10px] font-bold text-slate-600 hover:border-vhcc-blue hover:text-vhcc-blue group-hover/tooltip:border-vhcc-blue group-hover/tooltip:text-vhcc-blue focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-vhcc-blue"
          data-tooltip-trigger
          aria-label={`View course details for ${normalizedCode}`}
          aria-controls={`course-tip-inline-${normalizedCode.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`}
          aria-expanded="false"
          aria-haspopup="dialog"
        >
          i
        </button>
        <div
          id={`course-tip-inline-${normalizedCode.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`}
          role="dialog"
          aria-label={`Course details for ${normalizedCode}`}
          data-tooltip-panel
          data-tooltip-for={`course-tip-inline-${normalizedCode.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`}
          tabindex="-1"
          class="pointer-events-none invisible fixed inset-x-3 bottom-3 z-50 max-h-[50vh] overflow-y-auto rounded-md border border-slate-300 bg-white p-3 text-sm text-slate-700 opacity-0 shadow-lg transition-opacity sm:absolute sm:inset-auto sm:left-0 sm:top-full sm:z-50 sm:mt-2 sm:w-80 sm:max-w-[calc(100vw-4rem)]"
        >
          <div class="flex items-start justify-between gap-2">
            <p class="font-semibold text-vhcc-navy wrap-break-word">
              {normalizedCode}
              {resolvedTitle ? `: ${resolvedTitle}` : ""}
            </p>
            <button
              type="button"
              class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded border border-slate-300 text-slate-600 hover:border-vhcc-blue hover:text-vhcc-blue focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-vhcc-blue"
              data-tooltip-close
              aria-label="Close course details"
            >
              ×
            </button>
          </div>
          {resolvedCredits && (
            <p class="mt-1 text-slate-700 wrap-break-word">
              <span class="font-semibold">Credits:</span> {resolvedCredits}
            </p>
          )}
          {resolvedDescription && (
            <p class="mt-1 leading-relaxed wrap-break-word">
              {resolvedDescription}
            </p>
          )}
        </div>
      </>
    )
  }
</span>

<script is:inline>
  (() => {
    if (window.__vhccTooltipInit) return;
    window.__vhccTooltipInit = true;

    // Shared backdrop element (rendered in CatalogLayout)
    const backdrop = document.getElementById("tooltip-backdrop");

    const showBackdrop = () => {
      if (!backdrop) return;
      backdrop.style.opacity = "1";
      backdrop.style.pointerEvents = "auto";
    };
    const hideBackdrop = () => {
      if (!backdrop) return;
      backdrop.style.opacity = "0";
      backdrop.style.pointerEvents = "none";
    };

    const setOpen = (container, open, triggerEl) => {
      const tooltipId = container.dataset.tooltipId;
      const panel =
        container.querySelector("[data-tooltip-panel]") ||
        (tooltipId
          ? document.querySelector(`[data-tooltip-for="${tooltipId}"]`)
          : null);
      if (!panel) return;
      const triggers = container.querySelectorAll("[data-tooltip-trigger]");

      if (open) {
        // Portal panel to body so it sits in root stacking context above the backdrop
        const iBtn = container.querySelector("button[data-tooltip-trigger]");
        const rect = iBtn
          ? iBtn.getBoundingClientRect()
          : container.getBoundingClientRect();
        panel._portalParent = panel.parentElement;
        panel._portalNext = panel.nextSibling;
        panel._triggerEl = iBtn || triggerEl || null;
        document.body.appendChild(panel);
        const isMobile = window.innerWidth < 640;
        if (isMobile) {
          panel.style.cssText =
            "position:fixed;left:12px;right:12px;bottom:12px;top:auto;width:auto;max-width:none;z-index:50";
        } else {
          const panelWidth = 320;
          let left = rect.left;
          if (left + panelWidth > window.innerWidth - 16)
            left = window.innerWidth - panelWidth - 16;
          panel.style.cssText = `position:fixed;top:${rect.bottom + 6}px;left:${left}px;width:${panelWidth}px;bottom:auto;right:auto;z-index:50`;
        }
        panel.classList.remove("invisible", "opacity-0", "pointer-events-none");
        panel.classList.add("visible", "opacity-100", "pointer-events-auto");
        showBackdrop();
        const closeBtn = panel.querySelector("[data-tooltip-close]");
        if (closeBtn) closeBtn.focus();
      } else {
        panel.classList.add("invisible", "opacity-0", "pointer-events-none");
        panel.classList.remove("visible", "opacity-100", "pointer-events-auto");
        const returnTarget = panel._triggerEl;
        panel._triggerEl = null;
        // Restore panel to original position in DOM
        if (panel._portalParent) {
          panel._portalParent.insertBefore(panel, panel._portalNext || null);
          panel.style.cssText = "";
          panel._portalParent = null;
          panel._portalNext = null;
        }
        if (returnTarget) returnTarget.focus();
      }
      container.setAttribute("data-tooltip-open", open ? "true" : "false");
      triggers.forEach((trigger) => {
        trigger.setAttribute("aria-expanded", open ? "true" : "false");
      });
    };

    const closeAll = (except) => {
      document
        .querySelectorAll("[data-tooltip-container]")
        .forEach((container) => {
          if (except && container === except) return;
          setOpen(container, false);
        });
      // Hide backdrop only if no tooltip remains open
      const anyOpen = document.querySelector("[data-tooltip-open='true']");
      if (!anyOpen) hideBackdrop();
    };

    if (backdrop) backdrop.addEventListener("click", () => closeAll());

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const closeButton = target.closest("[data-tooltip-close]");
      if (closeButton) {
        // Panel may be portaled to body; find container via data attribute
        const panel = closeButton.closest("[data-tooltip-panel]");
        const containerId = panel?.dataset.tooltipFor;
        const container = containerId
          ? document.querySelector(
              `[data-tooltip-container][data-tooltip-id='${containerId}']`,
            )
          : closeButton.closest("[data-tooltip-container]");
        if (!container) return;
        setOpen(container, false);
        const anyOpen = document.querySelector("[data-tooltip-open='true']");
        if (!anyOpen) hideBackdrop();
        event.preventDefault();
        return;
      }

      const trigger = target.closest("[data-tooltip-trigger]");
      if (trigger && !target.closest("a")) {
        const container = trigger.closest("[data-tooltip-container]");
        if (!container) return;
        const isOpen = container.getAttribute("data-tooltip-open") === "true";
        closeAll(container);
        setOpen(container, !isOpen, !isOpen ? trigger : null);
        if (isOpen) {
          const anyOpen = document.querySelector("[data-tooltip-open='true']");
          if (!anyOpen) hideBackdrop();
        }
        event.preventDefault();
        return;
      }

      const inTooltip = target.closest("[data-tooltip-container]");
      if (!inTooltip) {
        closeAll();
      }
    });

    document.addEventListener("keydown", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      if (event.key === "Escape") closeAll();
    });
  })();
</script>
