---
import { getCollection, render } from "astro:content";
import { slugify } from "../lib/programOfStudy";
import {
  awardMeta,
  getAward,
  programSections,
  type AwardKey,
} from "../lib/programSources";

const pathnameParts = Astro.url.pathname.split("/").filter(Boolean);
const year = pathnameParts[0] ?? "";

const targetSections = programSections;

const allEntries = await getCollection("catalog");
const sectionEntries = allEntries
  .filter((entry) => entry.id.startsWith(`${year}/catalog/`))
  .filter((entry) => {
    const parts = entry.id.split("/");
    const section = parts[2] ?? "";
    return targetSections.includes(section) && !entry.id.endsWith("/index");
  });

const bucketMeta = awardMeta;

const buckets = new Map<AwardKey, { text: string; href: string }[]>(
  bucketMeta.map((meta) => [meta.key, []]),
);

for (const entry of sectionEntries) {
  const parts = entry.id.split("/");
  const section = parts[2] ?? "";
  const pageSlug = parts.slice(3).join("/");
  const pageHref = `/${year}/${section}/${pageSlug}`;

  const { headings } = await render(entry);
  for (const heading of headings) {
    // Degree/certificate titles are authored mostly as h2/h3 in these pages.
    if (heading.depth < 2 || heading.depth > 3) continue;

    const bucket = getAward(heading.text || "");
    if (!bucket) continue;

    const anchor = slugify(heading.text || "");
    if (!anchor) continue;

    const target = buckets.get(bucket);
    if (!target) continue;

    target.push({
      text: heading.text,
      href: `${pageHref}#${anchor}`,
    });
  }
}

for (const meta of bucketMeta) {
  const items = buckets.get(meta.key);
  if (!items) continue;
  items.sort((a, b) => a.text.localeCompare(b.text));
}
---

<div class="not-prose mt-6 space-y-8">
  {
    bucketMeta.map((meta) => {
      const items = buckets.get(meta.key) ?? [];
      if (items.length === 0) return null;

      return (
        <section>
          <h2 class="text-xl font-semibold text-vhcc-navy dark:text-sky-300">
            {meta.title}
          </h2>
          <ul class="mt-3 list-disc space-y-2 pl-6 text-gray-800 dark:text-gray-200">
            {items.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-vhcc-blue underline decoration-vhcc-blue/40 underline-offset-2 hover:text-vhcc-navy focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-vhcc-blue dark:text-sky-400 dark:decoration-sky-400/40 dark:hover:text-sky-300"
                >
                  {item.text}
                </a>
              </li>
            ))}
          </ul>
        </section>
      );
    })
  }
</div>
