---
import { getCollection } from "astro:content";
import CourseTooltip from "./CourseTooltip.astro";

type RowType = "course" | "options" | "note";

interface CourseMeta {
  code: string;
  title: string;
  credits: string;
  description: string;
}

type FootnotePart =
  | { kind: "text"; text: string }
  | { kind: "footnote"; footnote: string };

interface FootnoteText {
  parts: FootnotePart[];
}

interface ProgramRowInput {
  rowType?: "course" | "options" | "note";
  course?: string | null;
  codeOverride?: string;
  titleOverride?: string;
  creditsOverride?: string;
  optionLabel?: string;
  minChoices?: number | null;
  maxChoices?: number | null;
  options?: (string | null)[];
  note?: string;
}

interface ProgramTermInput {
  termLabel?: string;
  rows?: ProgramRowInput[];
}

interface ProgramNoteInput {
  number?: number | string | null;
  text?: string;
}

type NotePart =
  | { kind: "text"; text: string }
  | { kind: "course"; code: string; label?: string };

interface Props {
  title?: string;
  showTotals?: boolean;
  notes?: ProgramNoteInput[];
  terms?: ProgramTermInput[];
}

const {
  title = "Program of Study",
  showTotals = true,
  notes = [],
  terms = [],
} = Astro.props;

const instanceId = crypto.randomUUID().slice(0, 8);

const pathnameParts = Astro.url.pathname.split("/").filter(Boolean);
const year = pathnameParts[0] ?? "";

const courses = await getCollection("courses");
const yearCourses = courses.filter((entry) =>
  entry.id.startsWith(`${year}/courses/`),
);

const slugify = (value: string) =>
  value
    .toLowerCase()
    .trim()
    .replace(/[^a-z0-9\s-]/g, "")
    .replace(/\s+/g, "-")
    .replace(/-+/g, "-");

const courseMap = new Map<string, (typeof yearCourses)[number]>();
for (const course of yearCourses) {
  const slug = (course.id.split("/").pop() ?? "").toLowerCase();
  const code = (course.data.code ?? "").toLowerCase();
  const titleSlug = slugify(course.data.title ?? "");
  if (slug) courseMap.set(slug, course);
  if (code) courseMap.set(code, course);
  if (titleSlug) courseMap.set(titleSlug, course);
}

const resolveCourse = (ref: string | null | undefined) => {
  if (!ref) return null;
  const key = ref.toLowerCase();
  return courseMap.get(key) ?? null;
};

const parseCredits = (input: string | null | undefined) => {
  if (!input) return null;
  const cleaned = input.trim();
  if (!cleaned) return null;

  const range = cleaned.match(/^(\d+(?:\.\d+)?)\s*[-–]\s*(\d+(?:\.\d+)?)$/);
  if (range) {
    const min = Number.parseFloat(range[1]);
    const max = Number.parseFloat(range[2]);
    if (!Number.isNaN(min) && !Number.isNaN(max)) return { min, max };
  }

  const single = cleaned.match(/^(\d+(?:\.\d+)?)$/);
  if (single) {
    const value = Number.parseFloat(single[1]);
    if (!Number.isNaN(value)) return { min: value, max: value };
  }

  return null;
};

const fmt = (num: number) =>
  Number.isInteger(num) ? `${num}` : `${num.toFixed(1)}`;
const fmtRange = (min: number, max: number) =>
  min === max ? fmt(min) : `${fmt(min)}-${fmt(max)}`;

const clamp = (value: number, min: number, max: number) =>
  Math.max(min, Math.min(max, value));

type DisplayRow =
  | { kind: "note"; note: string }
  | {
      kind: "course";
      code: string;
      title: FootnoteText;
      creditsText: string;
      meta?: CourseMeta;
    }
  | {
      kind: "options";
      label: string;
      options: { code: string; title: FootnoteText; meta?: CourseMeta }[];
      creditsText: string;
    };

const stripMarkdown = (value: string) =>
  value
    .replace(/\[(.*?)\]\((.*?)\)/g, "$1")
    .replace(/[*_`~>#]/g, "")
    .trim();

const getCourseDescription = (entry: (typeof yearCourses)[number]) => {
  const body = stripMarkdown(entry.body || "");
  if (!body) return "No description available.";
  return body;
};

const splitNoteLinks = (value: string): FootnoteText => {
  const parts: FootnotePart[] = [];
  const noteLinkRegex = /\[(\d+)\]/g;
  let lastIndex = 0;

  for (const match of value.matchAll(noteLinkRegex)) {
    const start = match.index ?? 0;
    if (start > lastIndex) {
      parts.push({ kind: "text", text: value.slice(lastIndex, start) });
    }
    parts.push({ kind: "footnote", footnote: match[1] || "" });
    lastIndex = start + match[0].length;
  }

  if (lastIndex < value.length || parts.length === 0) {
    parts.push({ kind: "text", text: value.slice(lastIndex) });
  }

  return { parts };
};

const normalizedNotes = notes
  .map((note) => {
    const raw = note.number;
    if (raw === null || raw === undefined || raw === "") return null;
    const num = Number(raw);
    if (Number.isNaN(num) || num < 1) return null;
    return {
      number: Math.trunc(num),
      text: note.text?.trim() || "",
    };
  })
  .filter((note): note is { number: number; text: string } => note !== null)
  .sort((a, b) => a.number - b.number);

const courseTooltipTagRegex =
  /\{\%\s*coursetooltip\s+code=\"([^\"]+)\"(?:\s+label=\"([^\"]+)\")?\s*\/\%\}/gi;

const parseNoteParts = (text: string): NotePart[] => {
  const parts: NotePart[] = [];
  let lastIndex = 0;

  for (const match of text.matchAll(courseTooltipTagRegex)) {
    const start = match.index ?? 0;
    if (start > lastIndex) {
      parts.push({ kind: "text", text: text.slice(lastIndex, start) });
    }
    parts.push({
      kind: "course",
      code: (match[1] || "").trim(),
      label: match[2]?.trim() || undefined,
    });
    lastIndex = start + match[0].length;
  }

  if (lastIndex < text.length) {
    parts.push({ kind: "text", text: text.slice(lastIndex) });
  }

  return parts.length > 0 ? parts : [{ kind: "text", text }];
};

const notesWithParts = normalizedNotes.map((note) => ({
  ...note,
  parts: parseNoteParts(note.text),
}));

const noteMap = new Map(
  notesWithParts.map((note) => [String(note.number), note]),
);
const noteId = (footnote: string) => `program-note-${footnote}`;
const noteRefId = (contextId: string, footnote: string) =>
  `program-note-ref-${contextId}-${footnote}`;

const processedTerms = terms.map((term) => {
  const rows = term.rows ?? [];
  let termMin = 0;
  let termMax = 0;

  const displayRows: DisplayRow[] = rows.map((row) => {
    const rowType: RowType = row.rowType ?? "course";

    if (rowType === "note") {
      return {
        kind: "note",
        note: row.note || "",
      };
    }

    if (rowType === "options") {
      const optionRefs = (row.options ?? []).filter((value): value is string =>
        Boolean(value),
      );
      const optionItems = optionRefs.map((ref) => {
        const entry = resolveCourse(ref);
        if (entry) {
          const credits = entry.data.credits || "";
          return {
            code: entry.data.code,
            title: entry.data.title,
            credits: parseCredits(credits),
            meta: {
              code: entry.data.code,
              title: entry.data.title,
              credits,
              description: getCourseDescription(entry),
            },
          };
        }
        return {
          code: ref,
          title: ref,
          credits: null,
          meta: undefined,
        };
      });

      const optionRanges = optionItems
        .map((item) => item.credits)
        .filter(
          (parsed): parsed is { min: number; max: number } => parsed !== null,
        );

      const totalOptions = optionRanges.length;
      const rawMinChoices = row.minChoices ?? 1;
      const rawMaxChoices = row.maxChoices ?? Math.max(1, rawMinChoices);
      const minChoices = clamp(rawMinChoices, 0, totalOptions);
      const maxChoices = clamp(rawMaxChoices, minChoices, totalOptions);

      const byMin = [...optionRanges].sort((a, b) => a.min - b.min);
      const byMax = [...optionRanges].sort((a, b) => b.max - a.max);
      const optionMin = byMin
        .slice(0, minChoices)
        .reduce((sum, item) => sum + item.min, 0);
      const optionMax = byMax
        .slice(0, maxChoices)
        .reduce((sum, item) => sum + item.max, 0);

      termMin += optionMin;
      termMax += optionMax;

      return {
        kind: "options",
        label: row.optionLabel || "Choose one",
        options: optionItems.map((item) => ({
          code: item.code,
          title: splitNoteLinks(item.title),
          meta: item.meta,
        })),
        creditsText:
          totalOptions > 0
            ? fmtRange(optionMin, optionMax)
            : row.creditsOverride || "",
      };
    }

    const entry = resolveCourse(row.course);
    const code = row.codeOverride || entry?.data.code || row.course || "";
    const courseTitle = row.titleOverride || entry?.data.title || "";
    const creditsText = row.creditsOverride || entry?.data.credits || "";
    const parsed = parseCredits(creditsText);
    if (parsed) {
      termMin += parsed.min;
      termMax += parsed.max;
    }

    return {
      kind: "course",
      code,
      title: splitNoteLinks(courseTitle),
      creditsText,
      meta: entry
        ? {
            code: entry.data.code,
            title: entry.data.title,
            credits: entry.data.credits || "",
            description: getCourseDescription(entry),
          }
        : undefined,
    };
  });

  return {
    termLabel: term.termLabel || "Term",
    rows: displayRows,
    total: fmtRange(termMin, termMax),
    termMin,
    termMax,
  };
});

const programMin = processedTerms.reduce((sum, term) => sum + term.termMin, 0);
const programMax = processedTerms.reduce((sum, term) => sum + term.termMax, 0);
---

<section class="not-prose my-8">
  <h3 class="text-xl font-semibold text-vhcc-navy dark:text-sky-300">
    {title}
  </h3>

  <div class="mt-4 space-y-8">
    {
      processedTerms.map((term, termIndex) => {
        return (
          <section>
            <h4 class="mb-3 text-lg font-bold text-vhcc-navy dark:text-sky-300">
              {term.termLabel}
            </h4>
            <div>
              <table class="w-full border-collapse text-base table-fixed">
                <thead>
                  <tr>
                    <th class="w-1/4 border-b-2 border-slate-200 px-4 py-3 text-left text-sm font-medium text-gray-500 align-top dark:border-gray-600 dark:text-gray-400">
                      Course Number
                    </th>
                    <th class="w-1/2 border-b-2 border-slate-200 px-4 py-3 text-left text-sm font-medium text-gray-500 align-top dark:border-gray-600 dark:text-gray-400">
                      Course Title
                    </th>
                    <th class="w-1/4 border-b-2 border-slate-200 px-4 py-3 text-right text-sm font-medium text-gray-500 align-top dark:border-gray-600 dark:text-gray-400">
                      Credits
                    </th>
                  </tr>
                </thead>
                <tbody>
                  {term.rows.map((row, rowIndex) => {
                    if (row.kind === "note") {
                      return (
                        <tr>
                          <td
                            colspan={3}
                            class="border-b border-slate-100 px-4 py-3 text-gray-700 italic dark:border-gray-700 dark:text-gray-400"
                          >
                            {row.note}
                          </td>
                        </tr>
                      );
                    }

                    if (row.kind === "options") {
                      return (
                        <tr>
                          <td class="border-b border-slate-100 px-4 py-3 font-medium text-gray-700 align-top wrap-break-word dark:border-gray-700 dark:text-gray-400">
                            Option Group
                          </td>
                          <td class="border-b border-slate-100 px-4 py-3 text-gray-800 align-top wrap-break-word dark:border-gray-700 dark:text-gray-200">
                            <p class="font-medium text-gray-900 dark:text-gray-100">
                              {row.label}
                            </p>
                            <ul class="mt-1 list-disc pl-5 text-gray-700 dark:text-gray-300">
                              {row.options.map((item, optionIndex) => (
                                <li>
                                  <span class="font-medium">{item.code}</span>
                                  {": "}
                                  <span
                                    class="relative ml-1 align-middle"
                                    data-tooltip-container
                                    data-tooltip-id={`${instanceId}-course-tip-${termIndex}-${rowIndex}-${optionIndex}`}
                                  >
                                    <span
                                      class={
                                        item.meta
                                          ? "cursor-pointer underline decoration-dotted underline-offset-2 rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-vhcc-blue"
                                          : undefined
                                      }
                                      data-tooltip-trigger={
                                        item.meta ? "true" : undefined
                                      }
                                      role={item.meta ? "button" : undefined}
                                      tabindex={item.meta ? 0 : undefined}
                                      aria-label={
                                        item.meta
                                          ? `View details: ${item.code}`
                                          : undefined
                                      }
                                      aria-controls={
                                        item.meta
                                          ? `${instanceId}-course-tip-${termIndex}-${rowIndex}-${optionIndex}`
                                          : undefined
                                      }
                                      aria-expanded={
                                        item.meta ? "false" : undefined
                                      }
                                      aria-haspopup={
                                        item.meta ? "dialog" : undefined
                                      }
                                    >
                                      {item.title.parts.map(
                                        (part, partIndex) => {
                                          if (part.kind === "text")
                                            return part.text;
                                          return noteMap.has(part.footnote) ? (
                                            <sup class="ml-0.5 text-[0.7em] align-super">
                                              <a
                                                id={noteRefId(
                                                  `${termIndex}-${rowIndex}-${optionIndex}-${partIndex}`,
                                                  part.footnote,
                                                )}
                                                href={`#${noteId(part.footnote)}`}
                                                class="text-vhcc-blue hover:text-vhcc-navy focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-vhcc-blue"
                                                aria-label={`Jump to note ${part.footnote}`}
                                              >
                                                {part.footnote}
                                              </a>
                                            </sup>
                                          ) : (
                                            <sup class="ml-0.5 text-[0.7em] align-super">
                                              {part.footnote}
                                            </sup>
                                          );
                                        },
                                      )}
                                    </span>
                                    {item.meta && (
                                      <div
                                        id={`${instanceId}-course-tip-${termIndex}-${rowIndex}-${optionIndex}`}
                                        role="dialog"
                                        aria-label={`Course details for ${item.meta.code}`}
                                        data-tooltip-panel
                                        data-tooltip-for={`${instanceId}-course-tip-${termIndex}-${rowIndex}-${optionIndex}`}
                                        tabindex="-1"
                                        class="pointer-events-none invisible fixed inset-x-3 bottom-3 z-30 max-h-[50vh] overflow-y-auto rounded-lg bg-white p-4 text-base text-slate-700 opacity-0 shadow-xl ring-1 ring-black/5 transition-opacity sm:absolute sm:inset-auto sm:left-0 sm:top-full sm:z-20 sm:mt-2 sm:w-96 sm:max-w-[calc(100vw-4rem)] dark:bg-gray-800 dark:text-gray-200 dark:ring-white/10"
                                      >
                                        <div class="flex items-start justify-between gap-2">
                                          <p class="text-lg font-semibold text-vhcc-navy wrap-break-word dark:text-sky-300">
                                            {item.meta.code}:{" "}
                                            {item.meta.title}
                                          </p>
                                          <button
                                            type="button"
                                            class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded border border-slate-300 text-slate-600 hover:border-vhcc-blue hover:text-vhcc-blue focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-vhcc-blue dark:border-gray-600 dark:text-gray-300 dark:hover:border-sky-400 dark:hover:text-sky-400"
                                            data-tooltip-close
                                            aria-label="Close course details"
                                          >
                                            ×
                                          </button>
                                        </div>
                                        <p class="mt-1 text-slate-700 wrap-break-word dark:text-gray-300">
                                          <span class="font-semibold">
                                            Credits:
                                          </span>{" "}
                                          {item.meta.credits}
                                        </p>
                                        <p class="mt-1 leading-relaxed wrap-break-word">
                                          {item.meta.description}
                                        </p>
                                      </div>
                                    )}
                                  </span>
                                </li>
                              ))}
                            </ul>
                          </td>
                          <td class="border-b border-slate-100 px-4 py-3 text-right font-medium text-gray-900 align-top dark:border-gray-700 dark:text-gray-100">
                            {row.creditsText}
                          </td>
                        </tr>
                      );
                    }

                    return (
                      <tr>
                        <td class="border-b border-slate-100 px-4 py-3 font-medium text-gray-700 align-top wrap-break-word dark:border-gray-700 dark:text-gray-300">
                          {row.code}
                        </td>
                        <td class="border-b border-slate-100 px-4 py-3 text-gray-800 align-top wrap-break-word dark:border-gray-700 dark:text-gray-200">
                          <span
                            class="relative"
                            data-tooltip-container
                            data-tooltip-id={`${instanceId}-course-tip-${termIndex}-${rowIndex}`}
                          >
                            <span
                              class={
                                row.meta
                                  ? "cursor-pointer underline decoration-dotted underline-offset-2 rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-vhcc-blue"
                                  : undefined
                              }
                              data-tooltip-trigger={
                                row.meta ? "true" : undefined
                              }
                              role={row.meta ? "button" : undefined}
                              tabindex={row.meta ? 0 : undefined}
                              aria-label={
                                row.meta ? `View details: ${row.code}` : undefined
                              }
                              aria-controls={
                                row.meta
                                  ? `${instanceId}-course-tip-${termIndex}-${rowIndex}`
                                  : undefined
                              }
                              aria-expanded={row.meta ? "false" : undefined}
                              aria-haspopup={row.meta ? "dialog" : undefined}
                            >
                              {row.title.parts.map((part, partIndex) => {
                                if (part.kind === "text") return part.text;
                                return noteMap.has(part.footnote) ? (
                                  <sup class="ml-0.5 text-[0.7em] align-super">
                                    <a
                                      id={noteRefId(
                                        `${termIndex}-${rowIndex}-${partIndex}`,
                                        part.footnote,
                                      )}
                                      href={`#${noteId(part.footnote)}`}
                                      class="text-vhcc-blue hover:text-vhcc-navy focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-vhcc-blue"
                                      aria-label={`Jump to note ${part.footnote}`}
                                    >
                                      {part.footnote}
                                    </a>
                                  </sup>
                                ) : (
                                  <sup class="ml-0.5 text-[0.7em] align-super">
                                    {part.footnote}
                                  </sup>
                                );
                              })}
                            </span>
                            {row.meta && (
                              <div
                                id={`${instanceId}-course-tip-${termIndex}-${rowIndex}`}
                                role="dialog"
                                aria-label={`Course details for ${row.meta.code}`}
                                data-tooltip-panel
                                data-tooltip-for={`${instanceId}-course-tip-${termIndex}-${rowIndex}`}
                                tabindex="-1"
                                class="pointer-events-none invisible fixed inset-x-3 bottom-3 z-30 max-h-[50vh] overflow-y-auto rounded-lg bg-white p-4 text-base text-slate-700 opacity-0 shadow-xl ring-1 ring-black/5 transition-opacity sm:absolute sm:inset-auto sm:left-0 sm:top-full sm:z-20 sm:mt-2 sm:w-96 sm:max-w-[calc(100vw-4rem)] dark:bg-gray-800 dark:text-gray-200 dark:ring-white/10"
                              >
                                <div class="flex items-start justify-between gap-2">
                                  <p class="text-lg font-semibold text-vhcc-navy wrap-break-word dark:text-sky-300">
                                    {row.meta.code}: {row.meta.title}
                                  </p>
                                  <button
                                    type="button"
                                    class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded border border-slate-300 text-slate-600 hover:border-vhcc-blue hover:text-vhcc-blue focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-vhcc-blue dark:border-gray-600 dark:text-gray-300 dark:hover:border-sky-400 dark:hover:text-sky-400"
                                    data-tooltip-close
                                    aria-label="Close course details"
                                  >
                                    ×
                                  </button>
                                </div>
                                <p class="mt-1 text-slate-700 wrap-break-word dark:text-gray-300">
                                  <span class="font-semibold">Credits:</span>{" "}
                                  {row.meta.credits}
                                </p>
                                <p class="mt-1 leading-relaxed wrap-break-word">
                                  {row.meta.description}
                                </p>
                              </div>
                            )}
                          </span>
                        </td>
                        <td class="border-b border-slate-100 px-4 py-3 text-right text-gray-900 align-top dark:border-gray-700 dark:text-gray-100">
                          {row.creditsText}
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
                {showTotals && (
                  <tfoot>
                    <tr class="border-t-2 border-slate-200 dark:border-gray-600">
                      <td class="px-4 py-3" />
                      <td class="px-4 py-3 text-right font-bold text-vhcc-navy dark:text-sky-300">
                        Total
                      </td>
                      <td class="px-4 py-3 text-right font-bold text-vhcc-navy dark:text-sky-300">
                        {term.total}
                      </td>
                    </tr>
                  </tfoot>
                )}
              </table>
            </div>
          </section>
        );
      })
    }
  </div>

  {
    showTotals && processedTerms.length > 0 && (
      <p class="mt-4 text-base font-semibold text-vhcc-navy dark:text-sky-300">
        Total Credits: {fmtRange(programMin, programMax)}
      </p>
    )
  }

  {
    notesWithParts.length > 0 && (
      <section
        class="mt-4 text-base text-gray-700 dark:text-gray-300"
        aria-label="Program notes"
      >
        <p class="font-semibold text-vhcc-navy dark:text-sky-300">
          Program Footnotes:
        </p>
        <ol class="mt-2 list-decimal space-y-1 pl-6 marker:text-gray-500">
          {notesWithParts.map((note) => (
            <li
              id={noteId(String(note.number))}
              value={note.number}
              class="[scroll-margin-top:var(--scroll-offset,9rem)]"
            >
              <span>
                {note.parts.map((part) => {
                  if (part.kind === "text") return part.text;
                  return <CourseTooltip code={part.code} label={part.label} />;
                })}
              </span>
            </li>
          ))}
        </ol>
      </section>
    )
  }
</section>

<script is:inline>
  (() => {
    if (window.__vhccTooltipInit) return;
    window.__vhccTooltipInit = true;

    const backdrop = document.getElementById("tooltip-backdrop");

    const showBackdrop = () => {
      if (!backdrop) return;
      backdrop.style.opacity = "1";
      backdrop.style.pointerEvents = "auto";
    };
    const hideBackdrop = () => {
      if (!backdrop) return;
      backdrop.style.opacity = "0";
      backdrop.style.pointerEvents = "none";
    };

    const setOpen = (container, open, triggerEl) => {
      const tooltipId = container.dataset.tooltipId;
      const panel =
        container.querySelector("[data-tooltip-panel]") ||
        (tooltipId
          ? document.querySelector(`[data-tooltip-for="${tooltipId}"]`)
          : null);
      if (!panel) return;
      const triggers = container.querySelectorAll("[data-tooltip-trigger]");

      if (open) {
        // Portal panel to body so it sits in root stacking context above the backdrop
        const triggerNode =
          triggerEl || container.querySelector("[data-tooltip-trigger]");
        const rect = triggerNode
          ? triggerNode.getBoundingClientRect()
          : container.getBoundingClientRect();
        panel._portalParent = panel.parentElement;
        panel._portalNext = panel.nextSibling;
        panel._triggerEl = triggerNode || null;
        document.body.appendChild(panel);
        const isMobile = window.innerWidth < 640;
        if (isMobile) {
          panel.style.cssText =
            "position:fixed;left:12px;right:12px;bottom:12px;top:auto;width:auto;max-width:none;z-index:50";
        } else {
          const panelWidth = 384;
          let left = rect.left;
          if (left + panelWidth > window.innerWidth - 16)
            left = window.innerWidth - panelWidth - 16;
          if (left < 16) left = 16;
          // Provisionally place below the trigger — panel is still
          // invisible here, so measuring its height doesn't cause any
          // visible jump.
          panel.style.cssText = `position:fixed;top:${rect.bottom + 6}px;left:${left}px;width:${panelWidth}px;bottom:auto;right:auto;z-index:50`;
          const panelHeight = panel.offsetHeight;
          const spaceBelow = window.innerHeight - rect.bottom - 6;
          const spaceAbove = rect.top - 6;
          if (panelHeight > spaceBelow && spaceAbove > spaceBelow) {
            // Not enough room below, but more room above — flip it.
            panel.style.top = `${Math.max(16, rect.top - panelHeight - 6)}px`;
          } else if (panelHeight > spaceBelow) {
            // Not enough room either side of the trigger — pin inside the
            // viewport instead of letting it run off the bottom, since a
            // fixed-position panel doesn't move when the page scrolls.
            panel.style.top = `${Math.max(16, window.innerHeight - panelHeight - 16)}px`;
          }
        }
        panel.classList.remove("invisible", "opacity-0", "pointer-events-none");
        panel.classList.add("visible", "opacity-100", "pointer-events-auto");
        panel.setAttribute("aria-modal", "true");
        showBackdrop();
        const closeBtn = panel.querySelector("[data-tooltip-close]");
        if (closeBtn) closeBtn.focus();
      } else {
        panel.classList.add("invisible", "opacity-0", "pointer-events-none");
        panel.classList.remove("visible", "opacity-100", "pointer-events-auto");
        panel.removeAttribute("aria-modal");
        const returnTarget = panel._triggerEl;
        panel._triggerEl = null;
        // Restore panel to original position in DOM
        if (panel._portalParent) {
          panel._portalParent.insertBefore(panel, panel._portalNext || null);
          panel.style.cssText = "";
          panel._portalParent = null;
          panel._portalNext = null;
        }
        if (returnTarget) returnTarget.focus();
      }
      container.setAttribute("data-tooltip-open", open ? "true" : "false");
      triggers.forEach((trigger) => {
        trigger.setAttribute("aria-expanded", open ? "true" : "false");
      });
    };

    const closeAll = (except) => {
      document
        .querySelectorAll("[data-tooltip-container]")
        .forEach((container) => {
          if (except && container === except) return;
          setOpen(container, false);
        });
      const anyOpen = document.querySelector("[data-tooltip-open='true']");
      if (!anyOpen) hideBackdrop();
    };

    if (backdrop) backdrop.addEventListener("click", () => closeAll());

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const closeButton = target.closest("[data-tooltip-close]");
      if (closeButton) {
        // Panel may be portaled to body; find container via data attribute
        const panel = closeButton.closest("[data-tooltip-panel]");
        const containerId = panel?.dataset.tooltipFor;
        const container = containerId
          ? document.querySelector(
              `[data-tooltip-container][data-tooltip-id='${containerId}']`,
            )
          : closeButton.closest("[data-tooltip-container]");
        if (!container) return;
        setOpen(container, false);
        const anyOpen = document.querySelector("[data-tooltip-open='true']");
        if (!anyOpen) hideBackdrop();
        event.preventDefault();
        return;
      }

      const trigger = target.closest("[data-tooltip-trigger]");
      if (trigger && !target.closest("a")) {
        const container = trigger.closest("[data-tooltip-container]");
        if (!container) return;
        const isOpen = container.getAttribute("data-tooltip-open") === "true";
        closeAll(container);
        setOpen(container, !isOpen, !isOpen ? trigger : null);
        if (isOpen) {
          const anyOpen = document.querySelector("[data-tooltip-open='true']");
          if (!anyOpen) hideBackdrop();
        }
        event.preventDefault();
        return;
      }

      const inTooltip = target.closest("[data-tooltip-container]");
      if (!inTooltip) closeAll();
    });

    document.addEventListener("keydown", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      if (event.key === "Escape") closeAll();

      // Course titles that contain a footnote link can't be real <button>
      // elements (a <button> can't contain an <a>), so they're marked
      // role="button" instead and don't get native Enter/Space activation —
      // wire that up here. Scoped to [role="button"] so real <button>
      // triggers (which already activate natively) aren't double-toggled.
      if (event.key === "Enter" || event.key === " ") {
        const trigger = target.closest('[data-tooltip-trigger][role="button"]');
        if (trigger && !target.closest("a")) {
          event.preventDefault();
          const container = trigger.closest("[data-tooltip-container]");
          if (!container) return;
          const isOpen =
            container.getAttribute("data-tooltip-open") === "true";
          closeAll(container);
          setOpen(container, !isOpen, !isOpen ? trigger : null);
          if (isOpen) {
            const anyOpen = document.querySelector(
              "[data-tooltip-open='true']",
            );
            if (!anyOpen) hideBackdrop();
          }
        }
      }

      // Keep Tab inside the open panel — otherwise keyboard users can
      // tab past it into the dimmed page behind it.
      if (event.key === "Tab") {
        const openPanel = document.querySelector(
          "[data-tooltip-panel].visible",
        );
        if (!openPanel) return;
        const focusable = openPanel.querySelectorAll(
          'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
        );
        if (focusable.length === 0) return;
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
    });
  })();
</script>
