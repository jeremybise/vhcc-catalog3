---
import "../styles/global.css";
import { Image } from "astro:assets";
import logo from "../assets/image007.png";
import CatalogSearch from "../components/CatalogSearch";

export interface Props {
  title: string;
  year: string;
  availableYears?: string[];
  /** Whether this catalog year is archived. Shows a banner when true. */
  isArchived?: boolean;
  /** The year slug of the current (non-archived) catalog to link to in the banner. */
  currentYear?: string;
  sidebar: {
    label: string;
    slug: string;
    href: string;
    pages: { title: string; href: string; order: number }[];
  }[];
  currentHref: string;
  currentSection: string;
  headings?: { depth: number; slug: string; text: string }[];
  prevPage?: { href: string; title: string } | null;
  nextPage?: { href: string; title: string } | null;
  breadcrumbs?: { label: string; href: string }[];
}

const {
  title,
  year,
  availableYears = [year],
  isArchived = false,
  currentYear,
  sidebar,
  currentHref,
  currentSection,
  headings = [],
  prevPage = null,
  nextPage = null,
  breadcrumbs = [],
} = Astro.props;
const tocHeadings = headings.filter((heading) => heading.depth === 2);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} — {year} Catalog</title>
    <style is:global>
      .content-heading {
        position: relative;
        scroll-margin-top: var(--scroll-offset, 9rem);
      }

      .heading-anchor {
        position: absolute;
        left: -1.4rem;
        top: 50%;
        transform: translateY(-50%);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1rem;
        height: 1rem;
        color: #64748b;
        opacity: 0;
        text-decoration: none;
        transition:
          opacity 150ms ease-in-out,
          color 150ms ease-in-out;
      }

      .content-heading:hover .heading-anchor,
      .content-heading:focus-within .heading-anchor,
      .content-heading:target .heading-anchor,
      .heading-anchor:focus-visible {
        opacity: 1;
      }

      .heading-anchor:hover,
      .heading-anchor:focus-visible {
        color: #1d4ed8;
      }

      .content-heading .heading-anchor svg {
        display: block;
      }

      .dark .heading-anchor {
        color: #94a3b8;
      }
      .dark .heading-anchor:hover,
      .dark .heading-anchor:focus-visible {
        color: #38bdf8;
      }

      /* Sticky title bar: relaxed when at top, compact with shadow when stuck */
      #page-title-bar {
        border-bottom: 1px solid transparent;
      }
      #page-title-bar h1 {
        font-size: clamp(1.75rem, 4vw, 2.75rem);
        transition: font-size 0.2s ease;
      }
      #page-title-bar[data-stuck] h1 {
        font-size: clamp(1.125rem, 2.5vw, 1.5rem);
      }
      #page-title-bar[data-stuck] {
        padding-top: 0.625rem;
        padding-bottom: 0.625rem;
        border-bottom-color: #e2e8f0;
        box-shadow: 0 2px 8px -2px rgba(0, 0, 0, 0.1);
      }
      .dark #page-title-bar[data-stuck] {
        border-bottom-color: #374151;
        box-shadow: 0 2px 8px -2px rgba(0, 0, 0, 0.4);
      }

      .prose-table-scroll {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
      }

      .prose-table-scroll:focus-visible {
        outline: 2px solid #4578ba;
        outline-offset: 2px;
      }

      /* Tables fill their scroll wrapper and use fixed equal-width columns */
      .prose table:not([class]) {
        width: 100%;
        table-layout: fixed;
      }

      /* Cell padding */
      .prose table:not([class]) th,
      .prose table:not([class]) td {
        padding: 0.5rem 0.75rem;
      }

      /* Header row */
      .prose table:not([class]) thead th {
        white-space: nowrap;
        background-color: #e9eef5;
        border-bottom: 2px solid #cbd5e1 !important;
      }

      /* Subtle alternating rows */
      .prose table:not([class]) tbody tr:nth-child(even) td {
        background-color: rgba(0, 0, 0, 0.025);
      }

      /* Dark mode */
      .dark .prose table:not([class]) thead th {
        background-color: #2d3748;
        border-bottom-color: #4a5568 !important;
      }
      .dark .prose table:not([class]) tbody tr:nth-child(even) td {
        background-color: rgba(255, 255, 255, 0.04);
      }

      /* Prevent long unbreakable strings (URLs, codes) from overflowing */
      .prose {
        overflow-wrap: break-word;
        word-break: break-word;
      }

      .dark .prose h1 {
        color: #7dd3fc;
      }
      .dark .prose a {
        color: #38bdf8;
      }
      .dark .prose a:hover {
        color: #7dd3fc;
      }
    </style>
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("vhcc-theme");
          var prefersDark = window.matchMedia(
            "(prefers-color-scheme: dark)",
          ).matches;
          if (stored === "dark" || (!stored && prefersDark)) {
            document.documentElement.classList.add("dark");
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body
    class="bg-white text-gray-900 antialiased dark:bg-gray-950 dark:text-gray-100"
  >
    <!-- Backdrop for course tooltips -->
    <div
      id="tooltip-backdrop"
      aria-hidden="true"
      style="position:fixed;inset:0;background:rgba(0,0,0,0.35);z-index:40;opacity:0;pointer-events:none;transition:opacity 150ms ease"
    >
    </div>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-50 focus:rounded-md focus:bg-white focus:px-3 focus:py-2 focus:text-vhcc-navy focus:ring-2 focus:ring-vhcc-blue dark:focus:bg-gray-800 dark:focus:text-white"
    >
      Skip to main content
    </a>

    <!-- Top header -->
    <header
      id="site-header"
      class="bg-vhcc-navy text-white px-3 sm:px-4 py-3 flex items-center gap-3 sticky top-0 z-10 shadow-md"
    >
      <a
        href={`/${year}`}
        class="flex items-center gap-2 text-white font-semibold text-lg sm:text-xl hover:text-slate-200 transition-colors"
      >
        <Image
          src={logo}
          alt="Virginia Highlands Community College logo"
          class="h-6 w-auto sm:h-7"
          loading="eager"
          decoding="async"
          format="png"
        />
        <span class="tracking-tight leading-tight">College Catalog</span>
      </a>
      <label for="catalog-year-switcher" class="sr-only">Catalog Year</label>
      <span id="catalog-year-switcher-hint" class="sr-only">
        Selecting a year takes you to that catalog.
      </span>
      <select
        id="catalog-year-switcher"
        aria-describedby="catalog-year-switcher-hint"
        class="rounded-md border border-vhcc-blue bg-vhcc-navy px-2 py-1 text-sm text-white outline-none focus-visible:ring-2 focus-visible:ring-vhcc-blue"
        onchange="window.location.href='/' + this.value"
      >
        {
          availableYears.map((y) => (
            <option value={y} selected={y === year}>
              {y}
            </option>
          ))
        }
      </select>
      <div class="ml-auto flex items-center gap-2">
        <CatalogSearch client:load currentYear={year} />
        <button
          id="theme-toggle"
          type="button"
          aria-label="Toggle dark mode"
          class="flex items-center justify-center rounded-md p-1.5 text-white hover:bg-vhcc-blue/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-vhcc-blue transition-colors"
        >
          <!-- Sun: shown in dark mode -->
          <svg
            class="hidden dark:block h-5 w-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="4"></circle>
            <path
              d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
            ></path>
          </svg>
          <!-- Moon: shown in light mode -->
          <svg
            class="block dark:hidden h-5 w-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>
        <details class="lg:hidden group">
          <summary
            class="list-none cursor-pointer rounded-md p-1.5 hover:bg-vhcc-blue/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-vhcc-blue [&::-webkit-details-marker]:hidden"
          >
            <span class="sr-only">Toggle navigation menu</span>
            <!-- Hamburger: visible when closed -->
            <svg
              class="h-5 w-5 group-open:hidden"
              viewBox="0 0 20 20"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm1 4a1 1 0 100 2h12a1 1 0 100-2H4z"
                clip-rule="evenodd"></path>
            </svg>
            <!-- X: visible when open -->
            <svg
              class="h-5 w-5 hidden group-open:block"
              viewBox="0 0 20 20"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
                clip-rule="evenodd"></path>
            </svg>
          </summary>
          <nav
            class="fixed inset-x-0 z-20 overflow-y-auto border-t border-vhcc-navy/30 bg-white text-gray-900 shadow-xl dark:bg-gray-900 dark:text-gray-100 dark:border-vhcc-navy/50"
            style="top: var(--header-h, 52px); height: calc(100vh - var(--header-h, 52px))"
            aria-label="Mobile catalog navigation"
          >
            <ul class="py-3">
              {
                sidebar.map((section) => (
                  <li class="border-b border-gray-100 last:border-b-0 dark:border-gray-700">
                    <a
                      href={section.href}
                      class="block px-4 py-3 text-base font-semibold text-vhcc-navy hover:bg-slate-100 dark:text-sky-300 dark:hover:bg-gray-800"
                    >
                      {section.label}
                    </a>
                    {section.pages.length > 0 && (
                      <ul class="pb-2">
                        {section.pages.map((page) => (
                          <li>
                            <a
                              href={page.href}
                              aria-current={
                                page.href === currentHref ? "page" : undefined
                              }
                              class:list={[
                                "block px-6 py-2 text-base",
                                page.href === currentHref
                                  ? "text-vhcc-navy font-semibold bg-slate-50 dark:text-sky-300 dark:bg-gray-700"
                                  : "text-gray-700 hover:text-vhcc-navy hover:bg-slate-50 dark:text-gray-300 dark:hover:text-white dark:hover:bg-gray-700",
                              ]}
                            >
                              {page.title}
                            </a>
                          </li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))
              }
            </ul>
          </nav>
        </details>
      </div>
    </header>

    {
      isArchived && (
        <div
          role="alert"
          class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1 bg-amber-100 px-4 py-2.5 text-center text-sm text-amber-900 border-b border-amber-300 dark:bg-amber-900/30 dark:text-amber-200 dark:border-amber-800"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 20 20"
            fill="currentColor"
            class="h-4 w-4 shrink-0 text-amber-600"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z"
              clip-rule="evenodd"
            />
          </svg>
          <span>
            You are viewing an <strong>archived</strong> version of the {year}{" "}
            catalog.
          </span>
          {currentYear && (
            <a
              href={`/${currentYear}`}
              class="font-semibold underline hover:text-amber-700 transition-colors dark:hover:text-amber-300"
            >
              View the current {currentYear} catalog &rsaquo;
            </a>
          )}
        </div>
      )
    }

    <div class="flex min-h-[calc(100vh-52px)]">
      <!-- Sidebar -->
      <nav
        class="hidden lg:block w-72 shrink-0 bg-gray-50 border-r border-gray-200 overflow-y-auto sticky h-[calc(100vh-52px)] dark:bg-gray-900 dark:border-gray-700"
        style="top: var(--header-h, 52px)"
        aria-label="Catalog navigation"
      >
        <ul class="py-2">
          {
            sidebar.map((section) => (
              <li>
                {section.pages.length > 0 ? (
                  <details
                    class="group"
                    open={section.slug === currentSection || undefined}
                  >
                    <summary class="flex items-center justify-between px-4 py-2 text-sm font-semibold uppercase tracking-wide text-gray-600 cursor-pointer select-none hover:bg-slate-100 hover:text-vhcc-navy group-open:text-vhcc-navy list-none [&::-webkit-details-marker]:hidden dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-white dark:group-open:text-white">
                      <span>{section.label}</span>
                      <svg
                        class="w-3.5 h-3.5 shrink-0 ml-1 transition-transform group-open:rotate-90"
                        viewBox="0 0 20 20"
                        fill="currentColor"
                      >
                        <path
                          fill-rule="evenodd"
                          d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                          clip-rule="evenodd"
                        />
                      </svg>
                    </summary>
                    <ul class="pb-1">
                      {section.pages.map((page) => {
                        const isActive = page.href === currentHref;
                        return (
                          <li>
                            <a
                              href={page.href}
                              aria-current={isActive ? "page" : undefined}
                              class:list={[
                                "block py-1.5 pr-4 pl-6 text-base transition-colors",
                                isActive
                                  ? "bg-vhcc-blue/15 text-vhcc-navy font-semibold border-l-2 border-vhcc-green pl-5.5 dark:bg-sky-400/20 dark:text-sky-300 dark:border-emerald-400"
                                  : "text-gray-700 hover:bg-slate-100 hover:text-vhcc-navy dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-white",
                              ]}
                            >
                              {page.title}
                            </a>
                          </li>
                        );
                      })}
                    </ul>
                  </details>
                ) : (
                  <a
                    href={section.href}
                    aria-current={
                      section.href === currentHref ? "page" : undefined
                    }
                    class:list={[
                      "block px-4 py-2 text-sm font-semibold uppercase tracking-wide transition-colors",
                      section.href === currentHref
                        ? "bg-vhcc-blue/15 text-vhcc-navy border-l-2 border-vhcc-green dark:bg-sky-400/20 dark:text-sky-300 dark:border-emerald-400"
                        : "text-gray-600 hover:bg-slate-100 hover:text-vhcc-navy dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-white",
                    ]}
                  >
                    {section.label}
                  </a>
                )}
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex-1 min-w-0 flex flex-col">
        <!-- Sentinel: when this scrolls out of view, title bar is "stuck" -->
        <div
          id="title-bar-sentinel"
          aria-hidden="true"
          style="height:1px;margin-bottom:-1px"
        >
        </div>
        <!-- Sticky title bar (content column only, not over sidebar) -->
        <div
          id="page-title-bar"
          class="sticky z-9 bg-white/95 backdrop-blur-sm px-4 sm:px-6 lg:px-8 py-6 transition-[padding,box-shadow,border-color] duration-200 dark:bg-gray-950/95"
          style="top: var(--header-h, 52px)"
        >
          <div class="mx-auto w-full max-w-3xl">
            {
              breadcrumbs.length > 0 && (
                <nav
                  aria-label="Breadcrumb"
                  class="mb-0.5 flex items-center gap-1.5 text-xs text-gray-500 dark:text-gray-400 min-w-0"
                >
                  <a
                    href={`/${year}`}
                    class="shrink-0 text-vhcc-blue hover:text-vhcc-navy transition-colors dark:text-sky-400 dark:hover:text-sky-300"
                  >
                    {year} Catalog
                  </a>
                  {breadcrumbs.slice(0, -1).map((crumb) => (
                    <>
                      <span
                        aria-hidden="true"
                        class="shrink-0 text-gray-400 dark:text-gray-600"
                      >
                        &#8250;
                      </span>
                      <a
                        href={crumb.href}
                        class="shrink-0 text-vhcc-blue hover:text-vhcc-navy transition-colors dark:text-sky-400 dark:hover:text-sky-300"
                      >
                        {crumb.label}
                      </a>
                    </>
                  ))}
                  <span
                    aria-hidden="true"
                    class="shrink-0 text-gray-400 dark:text-gray-600"
                  >
                    &#8250;
                  </span>
                  <span class="text-gray-600 dark:text-gray-400 truncate">
                    {breadcrumbs[breadcrumbs.length - 1]?.label}
                  </span>
                </nav>
              )
            }
            <div
              class="[&_h1]:font-bold [&_h1]:text-vhcc-navy [&_h1]:dark:text-white [&_h1]:m-0 [&_h1]:leading-tight"
            >
              <slot name="title" />
            </div>
          </div>
        </div>

        <div class="flex-1 px-4 pt-2 pb-6 sm:px-6 lg:px-8 lg:pt-3 lg:pb-8">
          <div class="mx-auto w-full max-w-3xl">
            <!-- Main content -->
            <main id="main-content" class="min-w-0 w-full">
              <article
                class="prose prose-lg max-w-none prose-slate prose-headings:font-semibold prose-h1:hidden prose-h2:text-2xl sm:prose-h2:text-3xl prose-h3:text-lg sm:prose-h3:text-xl prose-a:text-vhcc-blue dark:prose-invert"
                data-pagefind-body
              >
                {
                  tocHeadings.length > 0 && (
                    <nav
                      class="not-prose mb-6 rounded-lg border border-slate-200 bg-slate-50 px-4 py-3 dark:border-gray-700 dark:bg-gray-800"
                      aria-label="On this page"
                    >
                      <p class="mb-2 flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.12em] text-vhcc-navy/85 dark:text-sky-300/85">
                        <span class="h-1.5 w-1.5 rounded-full bg-vhcc-green dark:bg-emerald-400" />
                        What's on this page
                      </p>
                      <ul class="space-y-1 text-sm">
                        {tocHeadings.map((heading) => (
                          <li>
                            <a
                              href={`#${heading.slug}`}
                              class="block rounded-md px-2 py-1 font-medium text-gray-700 transition-colors hover:bg-slate-100 hover:text-vhcc-navy focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-vhcc-blue dark:text-gray-300 dark:hover:bg-gray-700 dark:hover:text-white"
                            >
                              {heading.text}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </nav>
                  )
                }
                <slot />
              </article>

              {
                (prevPage || nextPage) && (
                  <nav
                    class="mt-12 grid w-full gap-3 border-t border-gray-200 pt-6 sm:grid-cols-2 dark:border-gray-700"
                    aria-label="Page navigation"
                  >
                    {prevPage ? (
                      <a
                        href={prevPage.href}
                        class="group rounded-lg border border-slate-200 bg-white p-4 hover:border-vhcc-blue/60 hover:bg-slate-50 dark:border-gray-700 dark:bg-gray-800 dark:hover:bg-gray-700"
                      >
                        <p class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">
                          Previous
                        </p>
                        <p class="mt-1 text-sm font-medium text-gray-900 group-hover:text-vhcc-navy dark:text-gray-100 dark:group-hover:text-white">
                          {prevPage.title}
                        </p>
                      </a>
                    ) : (
                      <div />
                    )}
                    {nextPage ? (
                      <a
                        href={nextPage.href}
                        class="group rounded-lg border border-slate-200 bg-white p-4 text-right hover:border-vhcc-blue/60 hover:bg-slate-50 dark:border-gray-700 dark:bg-gray-800 dark:hover:bg-gray-700"
                      >
                        <p class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">
                          Next
                        </p>
                        <p class="mt-1 text-sm font-medium text-gray-900 group-hover:text-vhcc-navy dark:text-gray-100 dark:group-hover:text-white">
                          {nextPage.title}
                        </p>
                      </a>
                    ) : (
                      <div />
                    )}
                  </nav>
                )
              }
            </main>
          </div>
        </div>
      </div>
      <script is:inline>
        const slugify = (text) =>
          text
            .toLowerCase()
            .trim()
            .replace(/[^a-z0-9\s-]/g, "")
            .replace(/\s+/g, "-")
            .replace(/-+/g, "-");

        const addHeadingAnchors = () => {
          const headings = document.querySelectorAll(
            "article.prose h2, article.prose h3, article.prose h4, article.prose h5, article.prose h6",
          );

          const usedIds = new Set();
          headings.forEach((heading) => {
            heading.classList.add("content-heading");
            if (heading.querySelector(".heading-anchor")) return;

            let id = heading.getAttribute("id");
            if (!id) {
              id = slugify(heading.textContent || "section") || "section";
              let i = 2;
              while (usedIds.has(id) || document.getElementById(id)) {
                id = `${id}-${i}`;
                i += 1;
              }
              heading.setAttribute("id", id);
            }
            usedIds.add(id);

            const anchor = document.createElement("a");
            anchor.href = `#${id}`;
            anchor.className = "heading-anchor";
            anchor.setAttribute(
              "aria-label",
              `Link to ${heading.textContent || "section"}`,
            );
            anchor.title = "Link to heading";
            anchor.innerHTML =
              '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07L12 4"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07L12 20"/></svg>';

            heading.prepend(anchor);
          });
        };

        const wrapTables = () => {
          document
            .querySelectorAll(".prose table:not([class])")
            .forEach((table, index) => {
              if (table.parentElement?.classList.contains("prose-table-scroll"))
                return;
              const wrapper = document.createElement("div");
              wrapper.className = "prose-table-scroll";
              // Scrollable regions need to be reachable and operable by
              // keyboard, and announced as a region, or their horizontal
              // content is effectively unavailable to keyboard/AT users.
              wrapper.setAttribute("tabindex", "0");
              wrapper.setAttribute("role", "region");
              const caption = table.querySelector("caption");
              wrapper.setAttribute(
                "aria-label",
                caption?.textContent?.trim() || `Table ${index + 1}`,
              );
              table.parentNode.insertBefore(wrapper, table);
              wrapper.appendChild(table);
            });
        };

        const initStickyTitleBar = () => {
          const sentinel = document.getElementById("title-bar-sentinel");
          const bar = document.getElementById("page-title-bar");
          if (!sentinel || !bar) return;
          const observer = new IntersectionObserver(
            ([entry]) => {
              if (!entry.isIntersecting) {
                bar.setAttribute("data-stuck", "");
              } else {
                bar.removeAttribute("data-stuck");
              }
            },
            {
              threshold: 0,
              rootMargin: `-${document.getElementById("site-header")?.offsetHeight ?? 52}px 0px 0px 0px`,
            },
          );
          observer.observe(sentinel);
        };

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", () => {
            addHeadingAnchors();
            wrapTables();
            initStickyTitleBar();
          });
        } else {
          addHeadingAnchors();
          wrapTables();
          initStickyTitleBar();
        }
      </script>
      <script>
        (function () {
          const header = document.getElementById("site-header");
          const titleBar = document.getElementById("page-title-bar");
          function syncOffsets() {
            const headerH = header?.offsetHeight ?? 52;
            document.documentElement.style.setProperty(
              "--header-h",
              headerH + "px",
            );
            // For scroll-margin-top: use the stuck (compact) title bar height
            // measured while data-stuck is temporarily forced on
            if (titleBar) {
              const wasStuck = titleBar.hasAttribute("data-stuck");
              if (!wasStuck) titleBar.setAttribute("data-stuck", "");
              const titleBarH = titleBar.offsetHeight;
              if (!wasStuck) titleBar.removeAttribute("data-stuck");
              document.documentElement.style.setProperty(
                "--scroll-offset",
                headerH + titleBarH + 8 + "px",
              );
            }
          }
          syncOffsets();
          window.addEventListener("resize", syncOffsets);
        })();
      </script>
      <script is:inline>
        document
          .getElementById("theme-toggle")
          ?.addEventListener("click", function () {
            var isDark = document.documentElement.classList.toggle("dark");
            try {
              localStorage.setItem("vhcc-theme", isDark ? "dark" : "light");
            } catch (e) {}
          });
      </script>
    </div>
  </body>
</html>
