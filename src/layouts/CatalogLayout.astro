---
import "../styles/global.css";
import { Image } from "astro:assets";
import logo from "../assets/image007.png";
import CatalogSearch from "../components/CatalogSearch";

export interface Props {
  title: string;
  year: string;
  availableYears?: string[];
  sidebar: {
    label: string;
    slug: string;
    href: string;
    pages: { title: string; href: string; order: number }[];
  }[];
  currentHref: string;
  currentSection: string;
  headings?: { depth: number; slug: string; text: string }[];
  prevPage?: { href: string; title: string } | null;
  nextPage?: { href: string; title: string } | null;
  breadcrumbs?: { label: string; href: string }[];
}

const {
  title,
  year,
  availableYears = [year],
  sidebar,
  currentHref,
  currentSection,
  headings = [],
  prevPage = null,
  nextPage = null,
  breadcrumbs = [],
} = Astro.props;
const tocHeadings = headings.filter((heading) => heading.depth === 2);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} — {year} Catalog</title>
    <style is:global>
      .content-heading {
        position: relative;
        scroll-margin-top: 5rem;
      }

      .heading-anchor {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1rem;
        height: 1rem;
        margin-left: 0.35rem;
        vertical-align: middle;
        line-height: 1;
        color: #64748b;
        opacity: 0;
        text-decoration: none;
        transition:
          opacity 150ms ease-in-out,
          color 150ms ease-in-out;
      }

      .content-heading:hover .heading-anchor,
      .content-heading:focus-within .heading-anchor,
      .content-heading:target .heading-anchor,
      .heading-anchor:focus-visible {
        opacity: 1;
      }

      .heading-anchor:hover,
      .heading-anchor:focus-visible {
        color: #1d4ed8;
      }

      .content-heading .heading-anchor svg {
        display: block;
      }
    </style>
  </head>
  <body class="bg-white text-gray-900 antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-50 focus:rounded-md focus:bg-white focus:px-3 focus:py-2 focus:text-vhcc-navy focus:ring-2 focus:ring-vhcc-blue"
    >
      Skip to main content
    </a>

    <!-- Top header -->
    <header
      id="site-header"
      class="bg-vhcc-navy text-white px-4 sm:px-6 py-3 flex items-center gap-3 sticky top-0 z-10 shadow-md"
    >
      <a
        href={`/${year}`}
        class="flex items-center gap-2 text-white font-semibold text-lg sm:text-xl hover:text-slate-200 transition-colors"
      >
        <Image
          src={logo}
          alt="Virginia Highlands Community College logo"
          class="h-6 w-auto sm:h-7"
          loading="eager"
          decoding="async"
          format="png"
        />
        <span class="tracking-tight leading-tight">College Catalog</span>
      </a>
      <label for="catalog-year-switcher" class="sr-only">Catalog Year</label>
      <select
        id="catalog-year-switcher"
        class="rounded-md border border-vhcc-blue bg-vhcc-navy px-2 py-1 text-sm text-white outline-none focus-visible:ring-2 focus-visible:ring-vhcc-blue"
        onchange="window.location.href='/' + this.value"
      >
        {
          availableYears.map((y) => (
            <option value={y} selected={y === year}>
              {y}
            </option>
          ))
        }
      </select>
      <div class="ml-auto flex items-center gap-2">
        <CatalogSearch client:load currentYear={year} />
        <details class="xl:hidden group">
          <summary
            class="list-none cursor-pointer rounded-md p-1.5 hover:bg-vhcc-blue/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-vhcc-blue [&::-webkit-details-marker]:hidden"
          >
            <span class="sr-only">Toggle navigation menu</span>
            <!-- Hamburger: visible when closed -->
            <svg
              class="h-5 w-5 group-open:hidden"
              viewBox="0 0 20 20"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm1 4a1 1 0 100 2h12a1 1 0 100-2H4z"
                clip-rule="evenodd"></path>
            </svg>
            <!-- X: visible when open -->
            <svg
              class="h-5 w-5 hidden group-open:block"
              viewBox="0 0 20 20"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
                clip-rule="evenodd"></path>
            </svg>
          </summary>
          <nav
            class="fixed inset-x-0 z-20 overflow-y-auto border-t border-vhcc-navy/30 bg-white text-gray-900 shadow-xl"
            style="top: var(--header-h, 52px); height: calc(100vh - var(--header-h, 52px))"
            aria-label="Mobile catalog navigation"
          >
            <ul class="py-3">
              {
                sidebar.map((section) => (
                  <li class="border-b border-gray-100 last:border-b-0">
                    <a
                      href={section.href}
                      class="block px-4 py-3 text-base font-semibold text-vhcc-navy hover:bg-slate-100"
                    >
                      {section.label}
                    </a>
                    {section.pages.length > 0 && (
                      <ul class="pb-2">
                        {section.pages.map((page) => (
                          <li>
                            <a
                              href={page.href}
                              aria-current={
                                page.href === currentHref ? "page" : undefined
                              }
                              class:list={[
                                "block px-6 py-2 text-base",
                                page.href === currentHref
                                  ? "text-vhcc-navy font-semibold bg-slate-50"
                                  : "text-gray-700 hover:text-vhcc-navy hover:bg-slate-50",
                              ]}
                            >
                              {page.title}
                            </a>
                          </li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))
              }
            </ul>
          </nav>
        </details>
      </div>
    </header>

    <div class="flex min-h-[calc(100vh-52px)]">
      <!-- Sidebar -->
      <nav
        class="hidden xl:block w-72 shrink-0 bg-gray-50 border-r border-gray-200 overflow-y-auto sticky top-13 h-[calc(100vh-52px)]"
        aria-label="Catalog navigation"
      >
        <ul class="py-2">
          {
            sidebar.map((section) => (
              <li>
                {section.pages.length > 0 ? (
                  <details
                    class="group"
                    open={section.slug === currentSection || undefined}
                  >
                    <summary class="flex items-center justify-between px-4 py-2 text-sm font-semibold uppercase tracking-wide text-gray-600 cursor-pointer select-none hover:bg-slate-100 hover:text-vhcc-navy group-open:text-vhcc-navy list-none [&::-webkit-details-marker]:hidden">
                      <span>{section.label}</span>
                      <svg
                        class="w-3.5 h-3.5 shrink-0 ml-1 transition-transform group-open:rotate-90"
                        viewBox="0 0 20 20"
                        fill="currentColor"
                      >
                        <path
                          fill-rule="evenodd"
                          d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                          clip-rule="evenodd"
                        />
                      </svg>
                    </summary>
                    <ul class="pb-1">
                      {section.pages.map((page) => {
                        const isActive = page.href === currentHref;
                        return (
                          <li>
                            <a
                              href={page.href}
                              aria-current={isActive ? "page" : undefined}
                              class:list={[
                                "block py-1.5 pr-4 pl-6 text-base transition-colors",
                                isActive
                                  ? "bg-vhcc-blue/15 text-vhcc-navy font-semibold border-l-2 border-vhcc-green pl-5.5"
                                  : "text-gray-700 hover:bg-slate-100 hover:text-vhcc-navy",
                              ]}
                            >
                              {page.title}
                            </a>
                          </li>
                        );
                      })}
                    </ul>
                  </details>
                ) : (
                  <a
                    href={section.href}
                    aria-current={
                      section.href === currentHref ? "page" : undefined
                    }
                    class:list={[
                      "block px-4 py-2 text-sm font-semibold uppercase tracking-wide transition-colors",
                      section.href === currentHref
                        ? "bg-vhcc-blue/15 text-vhcc-navy border-l-2 border-vhcc-green"
                        : "text-gray-600 hover:bg-slate-100 hover:text-vhcc-navy",
                    ]}
                  >
                    {section.label}
                  </a>
                )}
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex-1 px-4 py-6 sm:px-6 lg:px-8 lg:py-8">
        <div class="mx-auto flex w-full max-w-screen-2xl gap-5 xl:gap-6">
          <!-- Main content -->
          <main id="main-content" class="min-w-0 flex-1 max-w-2xl">
            {
              breadcrumbs.length > 0 && (
                <nav
                  aria-label="Breadcrumb"
                  class="mb-4 flex items-center gap-1.5 text-sm text-gray-500"
                >
                  <a
                    href={`/${year}`}
                    class="hover:text-vhcc-navy transition-colors"
                  >
                    {year} Catalog
                  </a>
                  {breadcrumbs.map((crumb, i) => (
                    <>
                      <span aria-hidden="true" class="text-gray-300">
                        /
                      </span>
                      {i === breadcrumbs.length - 1 ? (
                        <span
                          class="font-medium text-vhcc-navy"
                          aria-current="page"
                        >
                          {crumb.label}
                        </span>
                      ) : (
                        <a
                          href={crumb.href}
                          class="hover:text-vhcc-navy transition-colors"
                        >
                          {crumb.label}
                        </a>
                      )}
                    </>
                  ))}
                </nav>
              )
            }
            <article
              class="prose prose-lg max-w-none prose-slate prose-headings:font-semibold prose-h1:text-4xl prose-h2:text-2xl prose-h1:text-vhcc-navy prose-a:text-vhcc-blue"
              data-pagefind-body
            >
              <slot />
            </article>

            {
              (prevPage || nextPage) && (
                <nav
                  class="mt-12 grid w-full max-w-2xl gap-3 border-t border-gray-200 pt-6 sm:grid-cols-2"
                  aria-label="Page navigation"
                >
                  {prevPage ? (
                    <a
                      href={prevPage.href}
                      class="group rounded-lg border border-slate-200 bg-white p-4 hover:border-vhcc-blue/60 hover:bg-slate-50"
                    >
                      <p class="text-xs font-semibold uppercase tracking-wider text-gray-500">
                        Previous
                      </p>
                      <p class="mt-1 text-sm font-medium text-gray-900 group-hover:text-vhcc-navy">
                        {prevPage.title}
                      </p>
                    </a>
                  ) : (
                    <div />
                  )}
                  {nextPage ? (
                    <a
                      href={nextPage.href}
                      class="group rounded-lg border border-slate-200 bg-white p-4 text-right hover:border-vhcc-blue/60 hover:bg-slate-50"
                    >
                      <p class="text-xs font-semibold uppercase tracking-wider text-gray-500">
                        Next
                      </p>
                      <p class="mt-1 text-sm font-medium text-gray-900 group-hover:text-vhcc-navy">
                        {nextPage.title}
                      </p>
                    </a>
                  ) : (
                    <div />
                  )}
                </nav>
              )
            }
          </main>

          <!-- Right TOC -->
          {
            tocHeadings.length > 0 && (
              <aside class="hidden lg:block w-60 xl:w-72 shrink-0 lg:ml-12">
                <div class="sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto rounded-xl border border-vhcc-blue/25 bg-linear-to-b from-slate-50 to-white p-4 shadow-sm ring-1 ring-white">
                  <p class="mb-3 flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.12em] text-vhcc-navy/85">
                    <span class="h-1.5 w-1.5 rounded-full bg-vhcc-green" />
                    What's on this page
                  </p>
                  <ul class="space-y-1 text-sm">
                    {tocHeadings.map((heading) => (
                      <li>
                        <a
                          href={`#${heading.slug}`}
                          class="group block rounded-md px-2 py-1 font-medium text-gray-700 transition-colors hover:bg-slate-100 hover:text-vhcc-navy focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-vhcc-blue"
                        >
                          {heading.text}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </aside>
            )
          }
        </div>
      </div>
    </div>
    <script is:inline>
      const slugify = (text) =>
        text
          .toLowerCase()
          .trim()
          .replace(/[^a-z0-9\s-]/g, "")
          .replace(/\s+/g, "-")
          .replace(/-+/g, "-");

      const addHeadingAnchors = () => {
        const headings = document.querySelectorAll(
          "article.prose h2, article.prose h3, article.prose h4, article.prose h5, article.prose h6",
        );

        const usedIds = new Set();
        headings.forEach((heading) => {
          heading.classList.add("content-heading");
          if (heading.querySelector(".heading-anchor")) return;

          let id = heading.getAttribute("id");
          if (!id) {
            id = slugify(heading.textContent || "section") || "section";
            let i = 2;
            while (usedIds.has(id) || document.getElementById(id)) {
              id = `${id}-${i}`;
              i += 1;
            }
            heading.setAttribute("id", id);
          }
          usedIds.add(id);

          const anchor = document.createElement("a");
          anchor.href = `#${id}`;
          anchor.className = "heading-anchor";
          anchor.setAttribute(
            "aria-label",
            `Link to ${heading.textContent || "section"}`,
          );
          anchor.title = "Link to heading";
          anchor.innerHTML =
            '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07L12 4"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07L12 20"/></svg>';

          heading.appendChild(anchor);
        });
      };

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", addHeadingAnchors);
      } else {
        addHeadingAnchors();
      }
    </script>
    <script>
      (function () {
        const header = document.getElementById("site-header");
        function syncHeaderHeight() {
          if (header)
            document.documentElement.style.setProperty(
              "--header-h",
              header.offsetHeight + "px",
            );
        }
        syncHeaderHeight();
        window.addEventListener("resize", syncHeaderHeight);
      })();
    </script>
  </body>
</html>
