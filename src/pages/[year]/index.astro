---
import { getCollection, render } from "astro:content";
import CatalogLayout from "../../layouts/CatalogLayout.astro";

export async function getStaticPaths() {
  const allEntries = await getCollection("catalog");
  const years = [...new Set(allEntries.map((e) => e.id.split("/")[0]))];
  return years.map((year) => ({ params: { year }, props: { year } }));
}

const { year } = Astro.props;

// Render the year's root index.mdoc
const yearEntries2 = await getCollection("catalogYears");
const yearIndex = yearEntries2.find(
  (e) => e.id === year || e.id.startsWith(`${year}/`),
);
if (!yearIndex) throw new Error(`No index entry found for year: ${year}`);
const { Content, headings } = await render(yearIndex);

// Build sidebar — same logic as [...slug].astro
const allEntries = await getCollection("catalog");
const availableYears = [
  ...new Set(allEntries.map((e) => e.id.split("/")[0])),
].sort((a, b) => {
  const aStart = Number.parseInt(a.split("-")[0] ?? a, 10);
  const bStart = Number.parseInt(b.split("-")[0] ?? b, 10);
  if (Number.isNaN(aStart) || Number.isNaN(bStart)) {
    return b.localeCompare(a);
  }
  return bStart - aStart;
});
const yearEntries = allEntries.filter((e) =>
  e.id.startsWith(`${year}/catalog/`),
);

type SidebarPage = { title: string; href: string; order: number };
type SidebarSection = {
  label: string;
  slug: string;
  href: string;
  order: number;
  pages: SidebarPage[];
};

const sectionsMap = new Map<string, SidebarSection>();

for (const e of yearEntries) {
  const parts = e.id.split("/");
  const section = parts[2];
  const pageParts = parts.slice(3);
  const isIndex =
    pageParts.length === 0 || pageParts[pageParts.length - 1] === "index";

  if (!sectionsMap.has(section)) {
    sectionsMap.set(section, {
      label: section
        .split("-")
        .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
        .join(" "),
      slug: section,
      href: `/${year}/${section}`,
      order: 99,
      pages: [],
    });
  }

  if (isIndex) {
    const sec = sectionsMap.get(section)!;
    sec.order = e.data.order ?? 99;
    sec.pages.unshift({
      title: e.data.title,
      href: `/${year}/${section}`,
      order: -1,
    });
  } else {
    const pageSlug = pageParts.join("/").replace(/\.mdoc$/, "");
    sectionsMap.get(section)!.pages.push({
      title: e.data.title,
      href: `/${year}/${section}/${pageSlug}`,
      order: e.data.order ?? 99,
    });
  }
}

const sidebar: SidebarSection[] = Array.from(sectionsMap.values())
  .sort((a, b) => a.order - b.order || a.slug.localeCompare(b.slug))
  .map((sec) => ({
    ...sec,
    pages: sec.pages.sort(
      (a, b) => a.order - b.order || a.title.localeCompare(b.title),
    ),
  }));

const orderedPages = sidebar.flatMap((section) =>
  section.pages.map((page) => ({ href: page.href, title: page.title })),
);
const currentHref = `/${year}`;
const currentIndex = orderedPages.findIndex(
  (page) => page.href === currentHref,
);
const prevPage = currentIndex > 0 ? orderedPages[currentIndex - 1] : null;
const nextPage =
  currentIndex === -1
    ? (orderedPages[0] ?? null)
    : currentIndex < orderedPages.length - 1
      ? orderedPages[currentIndex + 1]
      : null;
const tocHeadings = headings.filter((heading) => heading.depth >= 2);

const isArchived = yearIndex.data.archived ?? false;
// The current catalog is the latest non-archived year.
const currentYear = yearEntries2
  .filter((e) => !(e.data.archived ?? false))
  .map((e) => e.id.split("/")[0])
  .filter(Boolean)
  .sort((a, b) => {
    const aStart = Number.parseInt(a!.split("-")[0] ?? a!, 10);
    const bStart = Number.parseInt(b!.split("-")[0] ?? b!, 10);
    return bStart - aStart;
  })[0];
---

<CatalogLayout
  title={yearIndex.data.title}
  {year}
  {availableYears}
  {isArchived}
  currentYear={currentYear}
  {sidebar}
  {currentHref}
  currentSection=""
  headings={tocHeadings}
  {prevPage}
  {nextPage}
  breadcrumbs={[]}
>
  <h1 slot="title">{yearIndex.data.title}</h1>
  <Content />

  <nav class="not-prose mt-10" aria-label="Catalog sections">
    <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
      <h2 class="text-2xl font-bold text-vhcc-navy dark:text-sky-300">
        Catalog Sections
      </h2>
      <a
        href={`/${year}/print`}
        class="inline-flex items-center gap-2 rounded-md border border-slate-300 px-3 py-1.5 text-sm font-semibold text-vhcc-navy no-underline transition-colors hover:border-vhcc-blue hover:bg-vhcc-blue/5 dark:border-gray-600 dark:text-sky-300 dark:hover:border-sky-500 dark:hover:bg-sky-500/10"
      >
        <svg
          class="h-4 w-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6 9V2h12v7M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2M6 14h12v8H6v-8z"
          ></path>
        </svg>
        Print / Save as PDF
      </a>
    </div>
    <div class="grid gap-3 sm:grid-cols-2">
      {
        sidebar.map((section) => (
          <a
            href={section.href}
            class="group flex items-center gap-4 rounded-lg border border-gray-200 p-4 transition-colors hover:border-vhcc-blue hover:bg-vhcc-blue/5 no-underline dark:border-gray-700 dark:hover:border-sky-500 dark:hover:bg-sky-500/10"
          >
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-vhcc-navy text-sm font-bold text-white dark:bg-sky-800 dark:text-sky-200">
              {section.order}
            </span>
            <span class="text-sm font-semibold text-gray-900 group-hover:text-vhcc-blue dark:text-gray-100 dark:group-hover:text-sky-300">
              {section.pages[0]?.title ?? section.label}
            </span>
            <svg
              class="ml-auto h-4 w-4 shrink-0 text-gray-400 group-hover:text-vhcc-blue dark:text-gray-500 dark:group-hover:text-sky-300"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 5l7 7-7 7"
              />
            </svg>
          </a>
        ))
      }
    </div>
  </nav>
</CatalogLayout>
