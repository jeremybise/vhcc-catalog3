---
import { getCollection, render } from "astro:content";
import { Icon } from "astro-icon/components";
import CatalogLayout from "../../layouts/CatalogLayout.astro";

/** Maps a catalog section's folder slug to a Material Symbols icon. */
const sectionIcons: Record<string, string> = {
  "college-calendar": "material-symbols:calendar-month-outline",
  "about-the-college": "material-symbols:account-balance-outline",
  admissions: "material-symbols:how-to-reg-outline",
  "tuition-and-financial-aid": "material-symbols:payments-outline",
  "academic-policies": "material-symbols:policy-outline",
  "explanation-of-degrees-and-courses":
    "material-symbols:workspace-premium-outline",
  "school-of-arts-and-sciences": "material-symbols:science-outline",
  "school-of-business-and-industry":
    "material-symbols:business-center-outline",
  "school-of-health-professions": "material-symbols:health-and-safety-outline",
  "workforce-development-and-continuing-education":
    "material-symbols:handyman-outline",
  "course-descriptions": "material-symbols:menu-book-outline",
  "courses-of-study": "material-symbols:route-outline",
  "administration-faculty-instructional-and-support-staff":
    "material-symbols:groups-outline",
};
const defaultSectionIcon = "material-symbols:folder-outline";

export async function getStaticPaths() {
  const allEntries = await getCollection("catalog");
  const years = [...new Set(allEntries.map((e) => e.id.split("/")[0]))];
  return years.map((year) => ({ params: { year }, props: { year } }));
}

const { year } = Astro.props;

// Render the year's root index.mdoc
const yearEntries2 = await getCollection("catalogYears");
const yearIndex = yearEntries2.find(
  (e) => e.id === year || e.id.startsWith(`${year}/`),
);
if (!yearIndex) throw new Error(`No index entry found for year: ${year}`);
const { Content, headings } = await render(yearIndex);

// Build sidebar — same logic as [...slug].astro
const allEntries = await getCollection("catalog");
const availableYears = [
  ...new Set(allEntries.map((e) => e.id.split("/")[0])),
].sort((a, b) => {
  const aStart = Number.parseInt(a.split("-")[0] ?? a, 10);
  const bStart = Number.parseInt(b.split("-")[0] ?? b, 10);
  if (Number.isNaN(aStart) || Number.isNaN(bStart)) {
    return b.localeCompare(a);
  }
  return bStart - aStart;
});
const yearEntries = allEntries.filter((e) =>
  e.id.startsWith(`${year}/catalog/`),
);

type SidebarPage = { title: string; href: string; order: number };
type SidebarSection = {
  label: string;
  slug: string;
  href: string;
  order: number;
  pages: SidebarPage[];
};

const sectionsMap = new Map<string, SidebarSection>();

for (const e of yearEntries) {
  const parts = e.id.split("/");
  const section = parts[2];
  const pageParts = parts.slice(3);
  const isIndex =
    pageParts.length === 0 || pageParts[pageParts.length - 1] === "index";

  if (!sectionsMap.has(section)) {
    sectionsMap.set(section, {
      label: section
        .split("-")
        .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
        .join(" "),
      slug: section,
      href: `/${year}/${section}`,
      order: 99,
      pages: [],
    });
  }

  if (isIndex) {
    const sec = sectionsMap.get(section)!;
    sec.order = e.data.order ?? 99;
    sec.pages.unshift({
      title: e.data.title,
      href: `/${year}/${section}`,
      order: -1,
    });
  } else {
    const pageSlug = pageParts.join("/").replace(/\.mdoc$/, "");
    sectionsMap.get(section)!.pages.push({
      title: e.data.title,
      href: `/${year}/${section}/${pageSlug}`,
      order: e.data.order ?? 99,
    });
  }
}

const sidebar: SidebarSection[] = Array.from(sectionsMap.values())
  .sort((a, b) => a.order - b.order || a.slug.localeCompare(b.slug))
  .map((sec) => ({
    ...sec,
    pages: sec.pages.sort(
      (a, b) => a.order - b.order || a.title.localeCompare(b.title),
    ),
  }));

const orderedPages = sidebar.flatMap((section) =>
  section.pages.map((page) => ({ href: page.href, title: page.title })),
);
const currentHref = `/${year}`;
const currentIndex = orderedPages.findIndex(
  (page) => page.href === currentHref,
);
const prevPage = currentIndex > 0 ? orderedPages[currentIndex - 1] : null;
const nextPage =
  currentIndex === -1
    ? (orderedPages[0] ?? null)
    : currentIndex < orderedPages.length - 1
      ? orderedPages[currentIndex + 1]
      : null;
const tocHeadings = headings.filter((heading) => heading.depth >= 2);

const isArchived = yearIndex.data.archived ?? false;
// The current catalog is the latest non-archived year.
const currentYear = yearEntries2
  .filter((e) => !(e.data.archived ?? false))
  .map((e) => e.id.split("/")[0])
  .filter(Boolean)
  .sort((a, b) => {
    const aStart = Number.parseInt(a!.split("-")[0] ?? a!, 10);
    const bStart = Number.parseInt(b!.split("-")[0] ?? b!, 10);
    return bStart - aStart;
  })[0];
---

<CatalogLayout
  title={yearIndex.data.title}
  {year}
  {availableYears}
  {isArchived}
  currentYear={currentYear}
  {sidebar}
  {currentHref}
  currentSection=""
  headings={tocHeadings}
  {prevPage}
  {nextPage}
  breadcrumbs={[]}
>
  <h1 slot="title">{yearIndex.data.title}</h1>
  <Content />

  <nav class="not-prose mt-14" aria-label="Catalog sections">
    <h2 class="mb-6 text-3xl font-bold text-vhcc-navy dark:text-sky-300">
      Catalog Sections
    </h2>
    <div class="grid gap-2 sm:grid-cols-2 sm:-mx-4">
      {
        sidebar.map((section) => (
          <a
            href={section.href}
            class="group flex items-center gap-4 rounded-lg p-4 transition-colors hover:bg-vhcc-blue/5 no-underline dark:hover:bg-sky-500/10"
          >
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-vhcc-blue/10 text-vhcc-blue dark:bg-sky-400/10 dark:text-sky-300">
              <Icon
                name={sectionIcons[section.slug] ?? defaultSectionIcon}
                class="h-5 w-5"
                aria-hidden="true"
              />
            </span>
            <span class="text-lg font-semibold text-gray-900 group-hover:text-vhcc-blue dark:text-gray-100 dark:group-hover:text-sky-300">
              {section.pages[0]?.title ?? section.label}
            </span>
            <svg
              class="ml-auto h-4 w-4 shrink-0 text-gray-300 transition-transform group-hover:translate-x-0.5 group-hover:text-vhcc-blue dark:text-gray-600 dark:group-hover:text-sky-300"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 5l7 7-7 7"
              />
            </svg>
          </a>
        ))
      }
    </div>
  </nav>
</CatalogLayout>
