---
import { getCollection, render } from "astro:content";
import CatalogLayout from "../../layouts/CatalogLayout.astro";
import CourseDescriptionCategory from "../../components/CourseDescriptionCategory.astro";

export async function getStaticPaths() {
  const allEntries = await getCollection("catalog");

  return allEntries.map((entry) => {
    // entry.id looks like "2026-2027/catalog/about-the-college/core-values"
    const parts = entry.id.split("/");
    const year = parts[0]; // "2026-2027"
    // Everything after "[year]/catalog/" is the page slug
    // e.g. "about-the-college/core-values" or "about-the-college/index"
    const slugParts = parts.slice(2); // drop year and "catalog"

    // Treat "index" as the section root (no trailing segment)
    const isIndex = slugParts[slugParts.length - 1] === "index";
    const slug = isIndex
      ? slugParts.slice(0, -1).join("/")
      : slugParts.join("/");

    return {
      params: { year, slug: slug || undefined },
      props: { entry, year },
    };
  });
}

const { entry, year } = Astro.props;
const { Content, headings } = await render(entry);

// Build sidebar data: all entries for this year, grouped by section
const allEntries = await getCollection("catalog");
const allYearEntries = await getCollection("catalogYears");
const yearIndexEntry = allYearEntries.find(
  (e) => e.id === year || e.id.startsWith(`${year}/`),
);
const isArchived = yearIndexEntry?.data.archived ?? false;
const currentYear = allYearEntries
  .filter((e) => !(e.data.archived ?? false))
  .map((e) => e.id.split("/")[0])
  .filter(Boolean)
  .sort((a, b) => {
    const aStart = Number.parseInt(a!.split("-")[0] ?? a!, 10);
    const bStart = Number.parseInt(b!.split("-")[0] ?? b!, 10);
    return bStart - aStart;
  })[0];
const availableYears = [
  ...new Set(allEntries.map((e) => e.id.split("/")[0])),
].sort((a, b) => {
  const aStart = Number.parseInt(a.split("-")[0] ?? a, 10);
  const bStart = Number.parseInt(b.split("-")[0] ?? b, 10);
  if (Number.isNaN(aStart) || Number.isNaN(bStart)) {
    return b.localeCompare(a);
  }
  return bStart - aStart;
});
const yearEntries = allEntries.filter((e) =>
  e.id.startsWith(`${year}/catalog/`),
);

type SidebarPage = { title: string; href: string; order: number };
type SidebarSection = {
  label: string;
  slug: string;
  href: string;
  order: number;
  pages: SidebarPage[];
};

const sectionsMap = new Map<string, SidebarSection>();

for (const e of yearEntries) {
  const parts = e.id.split("/");
  // parts: [year, "catalog", section, ...page]
  const section = parts[2];
  const pageParts = parts.slice(3);
  const isIndex =
    pageParts.length === 0 || pageParts[pageParts.length - 1] === "index";

  if (!sectionsMap.has(section)) {
    sectionsMap.set(section, {
      label: section
        .split("-")
        .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
        .join(" "),
      slug: section,
      href: `/${year}/${section}`,
      order: 99,
      pages: [],
    });
  }

  if (isIndex) {
    const sec = sectionsMap.get(section)!;
    // Use the section index's order to sort sections in the sidebar
    sec.order = e.data.order ?? 99;
    // Add the index page as the first entry (order -1 so it always sorts first)
    sec.pages.unshift({
      title: e.data.title,
      href: `/${year}/${section}`,
      order: -1,
    });
  } else {
    const pageSlug = pageParts.join("/").replace(/\.mdoc$/, "");
    sectionsMap.get(section)!.pages.push({
      title: e.data.title,
      href: `/${year}/${section}/${pageSlug}`,
      order: e.data.order ?? 99,
    });
  }
}

// Sort sections by their index.mdoc order field, then by slug as tiebreaker
const sidebar: SidebarSection[] = Array.from(sectionsMap.values())
  .sort((a, b) => a.order - b.order || a.slug.localeCompare(b.slug))
  .map((sec) => ({
    ...sec,
    pages: sec.pages.sort(
      (a, b) => a.order - b.order || a.title.localeCompare(b.title),
    ),
  }));

// Determine current href for active state
const currentSlug = Astro.params.slug ?? "";
const currentSection = currentSlug.split("/")[0] ?? "";
const currentHref = currentSlug ? `/${year}/${currentSlug}` : `/${year}`;

const orderedPages = sidebar.flatMap((section) =>
  section.pages.map((page) => ({ href: page.href, title: page.title })),
);
const currentIndex = orderedPages.findIndex(
  (page) => page.href === currentHref,
);
const prevPage = currentIndex > 0 ? orderedPages[currentIndex - 1] : null;
const nextPage =
  currentIndex >= 0 && currentIndex < orderedPages.length - 1
    ? orderedPages[currentIndex + 1]
    : null;
// Detect course-descriptions leaf pages and generate headings from course data
const isCourseDescriptionsLeaf =
  currentSection === "course-descriptions" &&
  currentSlug !== "course-descriptions";
const courseDescCategory = isCourseDescriptionsLeaf
  ? (currentSlug.split("/")[1] ?? null)
  : null;

const slugify = (text: string) =>
  text
    .toLowerCase()
    .trim()
    .replace(/[^a-z0-9\s-]/g, "")
    .replace(/\s+/g, "-")
    .replace(/-+/g, "-");

let tocHeadings = headings.filter((heading) => heading.depth >= 2);

if (isCourseDescriptionsLeaf && courseDescCategory) {
  const allCourses = await getCollection("courses");
  const categoryCourses = allCourses
    .filter(
      (c) =>
        c.id.startsWith(`${year}/courses/`) &&
        c.data.category === courseDescCategory,
    )
    .sort((a, b) => a.data.code.localeCompare(b.data.code));
  tocHeadings = categoryCourses.map((c) => {
    const displayCode = c.data.code.replace("-", " ");
    const headingText = `${displayCode} - ${c.data.title}`;
    return { depth: 2, slug: slugify(headingText), text: headingText };
  });
}

// Build breadcrumbs: always include the section, plus the page title if this is a leaf page
const currentSidebarSection = sidebar.find((s) => s.slug === currentSection);
const sectionLabel =
  currentSidebarSection?.label ??
  currentSection
    .split("-")
    .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
    .join(" ");
const sectionHref = `/${year}/${currentSection}`;
const isLeafPage = currentHref !== sectionHref;
const breadcrumbs = isLeafPage
  ? [
      { label: sectionLabel, href: sectionHref },
      { label: entry.data.title, href: currentHref },
    ]
  : [{ label: sectionLabel, href: sectionHref }];
---

<CatalogLayout
  title={entry.data.title}
  {year}
  {availableYears}
  {isArchived}
  currentYear={currentYear}
  {sidebar}
  {currentHref}
  {currentSection}
  headings={tocHeadings}
  {prevPage}
  {nextPage}
  {breadcrumbs}
>
  <h1 slot="title">{entry.data.title}</h1>
  {
    isCourseDescriptionsLeaf && courseDescCategory ? (
      <CourseDescriptionCategory year={year} category={courseDescCategory} />
    ) : (
      <Content />
    )
  }
</CatalogLayout>
