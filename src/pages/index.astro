---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import logoColor from "../assets/VHCC-logo.png";
import logoWhite from "../assets/VHCC-logo-white.png";

const catalogYears = await getCollection("catalogYears");
const years = catalogYears
  .map((entry) => {
    const year = entry.id.split("/")[0];
    return { year, title: entry.data.title || year };
  })
  .sort((a, b) => {
    const aStart = Number.parseInt(a.year.split("-")[0] ?? a.year, 10);
    const bStart = Number.parseInt(b.year.split("-")[0] ?? b.year, 10);
    if (Number.isNaN(aStart) || Number.isNaN(bStart)) {
      return b.year.localeCompare(a.year);
    }
    return bStart - aStart;
  });
---

<Layout title="Virginia Highlands Community College Catalog">
  <main class="mx-auto max-w-3xl px-6 py-12">
    <div class="mb-10">
      <Image
        src={logoColor}
        alt="Virginia Highlands Community College"
        class="w-auto dark:hidden"
        style="height: 3.5rem;"
      />
      <Image
        src={logoWhite}
        alt="Virginia Highlands Community College"
        class="hidden w-auto dark:block"
        style="height: 3.5rem;"
      />
    </div>

    <h1 class="text-3xl font-semibold text-vhcc-navy dark:text-sky-300">
      College Catalogs
    </h1>
    <p class="mt-3 text-gray-700 dark:text-gray-200">
      Select a catalog year to view program, policy, and course information.
    </p>

    <ul class="mt-8 space-y-3">
      {
        years.map((item) => (
          <li>
            <a
              href={`/${item.year}`}
              class="block rounded-lg border border-gray-200 bg-white px-4 py-3 font-medium text-blue-900 hover:border-blue-300 hover:bg-blue-50 dark:border-gray-700 dark:bg-gray-800 dark:text-sky-300 dark:hover:border-sky-600 dark:hover:bg-gray-700"
            >
              {item.title}
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</Layout>
