---
title: "Health/Illness Concepts"
code: "NSG-170"
category: "nursing"
credits: "6"
prerequisites:
  - "2026/BIO-142"
  - "2026/NSG-100"
  - "2026/NSG-106"
  - "2026/NSG-130"
  - "2026/NSG-200"
corequisites:
  - "2026/BIO-150"
prerequisiteNote: "Prerequisites: BIO 142, NSG 100, NSG 106, NSG 130, NSG 200"
