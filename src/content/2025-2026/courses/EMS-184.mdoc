title: "Advanced Medical Care Laboratory"
code: "EMS-184"
category: "emergency-medical-services"
credits: "1"
prerequisites: []
corequisites:
  - "2026/EMS-183"
prerequisiteNote: "Prerequisite: Current Virginia EMT and CPR certification as approved by the Virginia Office of EMS program."
